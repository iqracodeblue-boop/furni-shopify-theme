<!-- sections/free-mockup-lead.liquid -->

<div class="mockup-page-wrapper">
  <div class="mockup-container">
    
    <!-- Left Side: Lead Form -->
    <div class="lead-form-section">
      <h1>Get Your Free Mockup</h1>
      <p>See how your new sign will look before you buy! Upload your logo or tell us your idea, and our design team will create a free, no-obligation mockup for you.</p>
      
      <form action="/contact#ContactForm" method="post" class="mockup-form">
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" placeholder="John Doe" required>
        </div>
        
        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required>
        </div>
        
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" placeholder="(123) 456-7890">
        </div>

        <div class="form-group">
          <label for="sign-type">Type of Sign Needed</label>
          <select id="sign-type" name="sign-type">
            <option value="outdoor">Outdoor Metal Sign</option>
            <option value="indoor">Indoor Reception Sign</option>
            <option value="push-thru">Push Thru Sign</option>
            <option value="other">Other / Not Sure</option>
          </select>
        </div>

        <div class="form-group">
          <label for="details">Project Details</label>
          <textarea id="details" name="details" rows="4" placeholder="Tell us about the size, colors, or specific needs..."></textarea>
        </div>

        <div class="form-group">
          <label for="logo-upload">Upload Your Logo / Current Sign (Optional)</label>
          <input type="file" id="logo-upload" name="logo-upload" accept="image/*, .pdf, .ai, .eps">
        </div>

        <button type="submit" class="btn-submit">Get My Free Mockup</button>
      </form>
    </div>

    <!-- Right Side: Image Gallery (Click to Open) -->
    <div class="gallery-section">
      <h2>Recent Mockup Examples</h2>
      <p>Click on any image to view it in full size.</p>
      
      <div class="gallery-grid">
        {% for block in section.blocks %}
          {% if block.settings.image %}
            <div class="gallery-item">
              <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" 
                   alt="{{ block.settings.image_alt }}" 
                   onclick="openLightbox('{{ block.settings.image | img_url: '1200x1200' }}', '{{ block.settings.image_alt }}')">
            </div>
          {% else %}
            <!-- Placeholder if no image is uploaded in settings -->
            <div class="gallery-item">
              <img src="https://via.placeholder.com/400x400/e0e0e0/666666?text=Mockup+Example" 
                   alt="Placeholder" 
                   onclick="openLightbox('https://via.placeholder.com/1200x1200/e0e0e0/666666?text=Mockup+Example', 'Placeholder')">
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<!-- Lightbox Modal for Zooming Images -->
<div id="lightbox-modal" class="lightbox-modal" onclick="closeLightbox(event)">
  <span class="lightbox-close" onclick="closeLightbox(event)">&times;</span>
  <img id="lightbox-img-content" class="lightbox-content" src="" alt="Enlarged Mockup">
</div>

<style>
  .mockup-page-wrapper {
    background: #f8f9fa;
    padding: 50px 20px;
    font-family: inherit;
  }
  .mockup-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 50px;
  }

  /* Lead Form Styles */
  .lead-form-section {
    flex: 1;
    background: #fff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .lead-form-section h1 {
    color: #0056b3;
    font-size: 2rem;
    margin-bottom: 15px;
  }
  .lead-form-section p {
    color: #666;
    margin-bottom: 25px;
    line-height: 1.6;
  }
  .mockup-form .form-group {
    margin-bottom: 20px;
  }
  .mockup-form label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
    color: #333;
  }
  .mockup-form input, .mockup-form select, .mockup-form textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    box-sizing: border-box;
  }
  .mockup-form input:focus, .mockup-form textarea:focus {
    border-color: #0056b3;
    outline: none;
  }
  .btn-submit {
    width: 100%;
    background: #0056b3;
    color: #fff;
    padding: 15px;
    border: none;
    border-radius: 4px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s;
  }
  .btn-submit:hover {
    background: #003d80;
  }

  /* Gallery Styles */
  .gallery-section {
    flex: 1;
  }
  .gallery-section h2 {
    color: #222;
    font-size: 1.8rem;
    margin-bottom: 10px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-top: 20px;
  }
  .gallery-item {
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    cursor: pointer;
    transition: transform 0.3s;
  }
  .gallery-item:hover {
    transform: scale(1.03);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Lightbox Styles */
  .lightbox-modal {
    display: none; /* Hidden by default */
    position: fixed;
    z-index: 9999;
    padding-top: 60px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.9); /* Black background */
    overflow: auto;
  }
  .lightbox-content {
    margin: auto;
    display: block;
    width: 80%;
    max-width: 800px;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(255,255,255,0.2);
  }
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    transition: 0.3s;
    cursor: pointer;
    z-index: 10000;
  }
  .lightbox-close:hover,
  .lightbox-close:focus {
    color: #bbb;
    text-decoration: none;
    cursor: pointer;
  }

  /* Responsive Design */
  @media (max-width: 900px) {
    .mockup-container {
      flex-direction: column;
    }
    .lead-form-section {
      order: 2; /* Form comes after gallery on mobile if preferred, or keep order 1. Let's keep form 1 */
    }
  }
  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr; /* 1 column on small mobiles */
    }
    .lightbox-content {
      width: 95%;
    }
  }
</style>

<!-- JavaScript for Lightbox -->
<script>
  function openLightbox(imgSrc, altText) {
    var modal = document.getElementById("lightbox-modal");
    var modalImg = document.getElementById("lightbox-img-content");
    
    modal.style.display = "block";
    modalImg.src = imgSrc;
    modalImg.alt = altText;
  }

  function closeLightbox(event) {
    // Close only if clicking the background (event target) or the close button
    if (event.target.id === 'lightbox-modal' || event.target.classList.contains('lightbox-close')) {
      var modal = document.getElementById("lightbox-modal");
      modal.style.display = "none";
    }
  }
  
  // Close lightbox on Escape key press
  document.addEventListener('keydown', function(event) {
    if(event.key === "Escape") {
      var modal = document.getElementById("lightbox-modal");
      if(modal.style.display === "block") {
        modal.style.display = "none";
      }
    }
  });
</script>

{% schema %}
{
  "name": "Free Mockup Lead Page",
  "settings": [],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Mockup Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Description (Alt Text)",
          "default": "Custom sign mockup example"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Free Mockup Lead Page",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}
