<style>
:root{
  --navy:#111111; --navy-deep:#0a0a0a; --gold:#0188CC; --cream:#ffffff; --ink:#111111; --muted:#666666;
  --line2:rgba(0,0,0,.12); --red:#0188CC;
  --fh:'DM Serif Display',Georgia,serif; --fb:'Inter',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:93%}
body{font-family:var(--fb);background:var(--cream);color:#333;line-height:1.6;}

.quote-page-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr; /* Split screen layout */
  min-height: 100vh;
}
@media(max-width: 880px) {
  .quote-page-wrapper { grid-template-columns: 1fr; }
}

/* Left Side (Dark with image) */
.quote-left {
  background: linear-gradient(rgba(10,10,10,0.85), rgba(10,10,10,0.95)), url('https://i.ibb.co/sdnM0Skc/QMva-E.jpg');
  background-size: cover;
  background-position: center;
  color: #fff;
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.quote-left-content {
  max-width: 500px;
}
.quote-left h1 {
  font-family: var(--fh);
  font-size: 2.5rem;
  line-height: 1.1;
  margin-bottom: 20px;
  font-weight: 400;
}
.quote-left h1 em { color: var(--gold); font-style: italic; }
.quote-left p {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.7);
  margin-bottom: 30px;
  line-height: 1.6;
}
.quote-left ul {
  list-style: none;
}
.quote-left ul li {
  font-size: 1rem;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(255,255,255,0.9);
}
.quote-left ul li svg {
  width: 20px; height: 20px; stroke: var(--gold); fill: none; stroke-width: 2.5; flex-shrink: 0;
}

/* Right Side (Form) */
.quote-right {
  background: #fff;
  padding: 60px 50px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}
.ship-badge {
  position: absolute;
  top: 30px;
  right: 30px;
  background: var(--gold);
  color: #fff;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.form-header h2 {
  font-family: var(--fh);
  font-size: 2rem;
  margin-bottom: 10px;
  font-weight: 400;
}
.form-header h2 em { color: var(--gold); font-style: italic; }
.form-header p {
  font-size: 0.9rem;
  color: var(--muted);
  margin-bottom: 30px;
  line-height: 1.6;
}
.qf-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px }
.qf-field { display:flex; flex-direction:column }
.qf-field.full { grid-column:span 2 }
.qf-label { font-family:var(--fb); font-size:.74rem; font-weight:700; color:var(--ink); letter-spacing:.06em; text-transform:uppercase; margin-bottom:7px; }
.qf-label .req { color:var(--red) }
.qf-input, .qf-select, .qf-textarea { font-family:var(--fb); font-size:.92rem; padding:13px 14px; border-radius:9px; border:1.5px solid var(--line2); background:#f9f9f9; color:var(--ink); width:100%; outline:none; transition: border-color 0.2s; }
.qf-input:focus, .qf-select:focus, .qf-textarea:focus { border-color:var(--gold); background:#fff; box-shadow:0 0 0 4px rgba(1,136,204,.14); }
.qf-textarea { resize:vertical; min-height:90px; font-family:var(--fb) }
.qf-submit { width:100%; background:var(--navy); color:#fff; font-family:var(--fb); font-size:.95rem; font-weight:700; padding:16px; border-radius:10px; margin-top:10px; display:inline-flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; border:none; transition: background 0.2s; }
.qf-submit:hover { background:var(--navy-deep); }
.qf-submit svg { width:16px; height:16px; stroke:#fff; stroke-width:2.5; fill:none }
.qf-note { font-size:.72rem; color:var(--muted); text-align:center; margin-top:14px; line-height: 1.5; }
.qf-note svg { width:11px; height:11px; stroke:var(--gold); fill:none; stroke-width:2; vertical-align:-1px; margin-right:3px; }
</style>

<div class="quote-page-wrapper">
  <!-- Left Side -->
  <div class="quote-left">
    <div class="quote-left-content">
      <h1>Custom 3D business signs. <em>Free quote & mockup.</em></h1>
      <p>From storefront channel letters to illuminated monuments, we build premium signage tailored to your brand.</p>
      <ul>
        <li><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> 3D Metal Backlit</li>
        <li><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> Acrylic Front Lit</li>
        <li><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> Lightbox Signs</li>
        <li><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> Halo Lit Letters</li>
      </ul>
    </div>
  </div>

  <!-- Right Side -->
  <div class="quote-right">
    <div class="ship-badge">FREE SHIPPING to all 50 States</div>
    <div class="form-header">
      <h2>Get a Free <em>Mockup in 2 Hours.</em></h2>
      <p>Tell us a little about your business and the sign you have in mind. We will send a designed mockup on your actual storefront, with no obligation.</p>
    </div>
    
    <form class="quote-form" id="quoteForm" onsubmit="event.preventDefault();alert('Request Sent! We will send your mockup within 2 hours.');this.reset();">
      <div class="qf-row">
        <div class="qf-field">
          <label class="qf-label" for="qf-name">Full Name <span class="req">*</span></label>
          <input type="text" id="qf-name" class="qf-input" placeholder="John Carter" required>
        </div>
        <div class="qf-field">
          <label class="qf-label" for="qf-phone">Phone <span class="req">*</span></label>
          <input type="tel" id="qf-phone" class="qf-input" placeholder="(555) 123-4567" required>
        </div>
      </div>
      <div class="qf-row">
        <div class="qf-field">
          <label class="qf-label" for="qf-email">Email <span class="req">*</span></label>
          <input type="email" id="qf-email" class="qf-input" placeholder="you@business.com" required>
        </div>
        <div class="qf-field">
          <label class="qf-label" for="qf-business">Business Name</label>
          <input type="text" id="qf-business" class="qf-input" placeholder="Your business">
        </div>
      </div>
      <div class="qf-row">
        <div class="qf-field">
          <label class="qf-label" for="qf-type">Sign Type <span class="req">*</span></label>
          <select id="qf-type" class="qf-select" required>
            <option value="">Select sign type</option>
            <option>Storefront signs</option>
            <option>Reception &amp; studio signs</option>
            <option>Medical and Clinic signs</option>
            <option>Coffee shops and restaurants</option>
            <option>Gym, Spa &amp; Salon signs</option>
            <option>Auto Services &amp; Real Estate</option>
            <option>Lobby &amp; Interior Signs</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="qf-field">
          <label class="qf-label" for="qf-state">State</label>
          <input type="text" id="qf-state" class="qf-input" placeholder="e.g. Texas">
        </div>
      </div>
      <div class="qf-row">
        <div class="qf-field full">
          <label class="qf-label" for="qf-msg">Project Details</label>
          <textarea id="qf-msg" class="qf-textarea" placeholder="Approximate size, dimensions, timeline, or any reference images you have..."></textarea>
        </div>
      </div>
      <button type="submit" class="qf-submit">
        Send Me My Free Mockup
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </button>
      <p class="qf-note">
        <svg viewBox="0 0 24 24"><path d="M12 2L3 7v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V7l-9-5z"/></svg>
        Your information is private. We never sell, share or spam.
      </p>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "NT Get A Quote Page",
  "presets": [
    {
      "name": "NT Get A Quote Page"
    }
  ]
}
{% endschema %}