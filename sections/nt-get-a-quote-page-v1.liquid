<style>
:root{
  --ts-xl:2.2rem; --ts-2xl:clamp(2.4rem,5vw,4.4rem);
  --navy:#111111; --navy-deep:#0a0a0a; --gold:#0188CC; --cream:#ffffff; --cream-deep:#f5f5f5;
  --ink:#111111; --body:#333333; --muted:#666666; --line:rgba(0,0,0,.07); --line2:rgba(0,0,0,.12);
  --red:#0188CC; --gold-line:rgba(1,136,204,.24); --gold-soft:rgba(1,136,204,.10);
  --fh:'DM Serif Display',Georgia,serif; --fb:'Inter',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:93%}
body{font-family:var(--fb);background:var(--cream);color:var(--body);line-height:1.6;}

/* 1. Split Layout (Form Section) */
.quote-page-wrapper { display: grid; grid-template-columns: 1fr 1.2fr; min-height: 100vh; }
@media(max-width: 880px) { .quote-page-wrapper { grid-template-columns: 1fr; } }
.quote-left {
  background-color: #0a0a0a;
  background-image: radial-gradient(ellipse 60% 40% at 20% 20%, rgba(1,136,204,0.15) 0%, transparent 60%);
  color: #fff; padding: 60px 50px; display: flex; flex-direction: column; justify-content: center;
}
.top-badge {
  display: inline-flex; align-items: center; gap: 8px; background: rgba(1,136,204,.12);
  border: 1px solid rgba(1,136,204,.3); padding: 8px 14px; border-radius: 50px;
  font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--gold); margin-bottom: 30px; width: fit-content;
}
.quote-left h1 { font-family: var(--fh); font-size: 2.4rem; line-height: 1.1; margin-bottom: 20px; font-weight: 400; }
.quote-left h1 em { color: var(--gold); font-style: italic; }
.left-desc { font-size: 1rem; color: rgba(255,255,255,0.7); margin-bottom: 30px; line-height: 1.6; max-width: 90%; }
.sign-list { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.sign-item { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.03); padding: 8px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); }
.sign-item img { width: 50px; height: 50px; object-fit: cover; border-radius: 8px; }
.sign-item span { font-size: 0.85rem; font-weight: 600; color: #fff; }
.quote-right { background: #f4f7fa; padding: 50px 40px; display: flex; flex-direction: column; justify-content: center; position: relative; }
.ship-badge { position: absolute; top: 20px; right: 20px; background: var(--gold); color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
.form-card { background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.05); }
.form-header h2 { font-family: var(--fh); font-size: 2rem; margin-bottom: 8px; font-weight: 400; }
.form-header h2 em { color: var(--gold); font-style: italic; }
.form-header p { font-size: 0.9rem; color: var(--muted); margin-bottom: 25px; }
.qf-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px }
.qf-field { display:flex; flex-direction:column }
.qf-field.full { grid-column:span 2 }
.qf-label { font-family:var(--fb); font-size:.74rem; font-weight:700; color:var(--ink); letter-spacing:.06em; text-transform:uppercase; margin-bottom:7px; }
.qf-label .req { color:var(--red) }
.qf-input, .qf-select, .qf-textarea { font-family:var(--fb); font-size:.92rem; padding:13px 14px; border-radius:9px; border:1.5px solid var(--line2); background:#f9f9f9; color:var(--ink); width:100%; outline:none; transition: border-color 0.2s; }
.qf-input:focus, .qf-select:focus, .qf-textarea:focus { border-color:var(--gold); background:#fff; box-shadow:0 0 0 4px rgba(1,136,204,.14); }
.qf-textarea { resize:vertical; min-height:80px; font-family:var(--fb) }
.qf-file-wrap { position: relative; border: 1.5px dashed var(--line2); border-radius: 9px; padding: 14px; text-align: center; background: #f9f9f9; cursor: pointer; height: 100%; display: flex; align-items: center; justify-content: center; }
.qf-file-wrap:hover { border-color: var(--gold); }
.qf-file-wrap input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.qf-file-label { font-size: 0.85rem; color: var(--muted); display: flex; align-items: center; justify-content: center; gap: 8px; }
.qf-file-label svg { width: 18px; height: 18px; stroke: var(--gold); fill: none; stroke-width: 2; }
.qf-submit { width:100%; background:var(--navy); color:#fff; font-family:var(--fb); font-size:.95rem; font-weight:700; padding:16px; border-radius:10px; margin-top:10px; display:inline-flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; border:none; transition: background 0.2s; }
.qf-submit:hover { background:var(--navy-deep); }
.qf-submit svg { width:16px; height:16px; stroke:#fff; stroke-width:2.5; fill:none }
.qf-note { font-size:.72rem; color:var(--muted); text-align:center; margin-top:14px; line-height: 1.5; }

/* Common Section Styles */
.section { padding:88px 48px; position:relative; overflow:hidden; background:#fff; }
.section-alt { background: var(--cream-deep); }
.sec-head { text-align:center; max-width:680px; margin:0 auto 56px }
.sec-label { display:inline-flex; align-items:center; gap:8px; font-family:var(--fb); font-size:.82rem; font-weight:700; letter-spacing:.28em; text-transform:uppercase; color:var(--red); margin-bottom:16px; }
.sec-label::before { content:""; width:24px; height:1px; background:var(--red); }
.sec-label::after { content:""; width:24px; height:1px; background:var(--red); }
.sec-h { font-family:var(--fh); font-size:var(--ts-xl); color:var(--ink); line-height:1.05; letter-spacing:-.02em; margin-bottom:14px; font-weight:400; }
.sec-h em { font-style:italic; color:var(--red) }
.sec-sub { font-family:var(--fb); font-size:1rem; color:var(--muted); line-height:1.65; max-width:580px; margin:0 auto; }

/* 2. Sign Types Cards */
.types-grid { max-width:1280px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.type-card { background:#fff; border-radius:16px; overflow:hidden; border:1px solid var(--line); transition:transform .35s, box-shadow .35s, border-color .3s; display:flex; flex-direction:column; text-decoration:none; color:inherit; }
.type-card:hover { transform:translateY(-6px); box-shadow:0 24px 48px rgba(0,0,0,.14); border-color:var(--gold-line); }
.type-card-img { position:relative; aspect-ratio:16/10; overflow:hidden; background:var(--navy); }
.type-card-img img { width:100%; height:100%; object-fit:cover; transition:transform .8s }
.type-card:hover .type-card-img img { transform:scale(1.06) }
.type-card-body { padding:24px 24px 26px; display:flex; flex-direction:column; flex:1 }
.type-card h3 { font-family:var(--fh); font-size:1.32rem; color:var(--ink); line-height:1.15; margin-bottom:8px; font-weight:400; }
.type-card p { font-family:var(--fb); font-size:.88rem; color:var(--muted); line-height:1.6; margin-bottom:18px; flex:1; }
.type-card-foot { display:flex; align-items:center; padding-top:16px; border-top:1px solid var(--line); }
.type-card-link { font-family:var(--fb); font-size:.78rem; font-weight:700; color:var(--navy); display:inline-flex; align-items:center; gap:5px; }

/* 3. Gallery (Sliding) */
.gallery-bento { max-width:1280px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); grid-auto-rows:200px; gap:14px; }
.gal-item { position:relative; overflow:hidden; border-radius:14px; background:#111; cursor:pointer; }
.gal-cycle { position:absolute; top:0; left:0; width:100%; height:100%; opacity:0; transition:opacity 1.1s cubic-bezier(.16,1,.3,1); z-index:1; }
.gal-cycle.active { opacity:1; z-index:2 }
.gal-cycle img { max-width:100%; width:100%; height:100%; object-fit:cover; display:block; }
.gal-item::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.78) 100%); opacity:.85; z-index:3; pointer-events:none; }
.gal-cap { position:absolute; left:18px; right:18px; bottom:16px; z-index:4; color:#fff; font-family:var(--fh); font-size:1.05rem; line-height:1.2; }
.gal-cap small { display:block; font-family:var(--fb); font-size:.7rem; font-weight:500; color:var(--gold); letter-spacing:.14em; text-transform:uppercase; margin-bottom:4px; }
.gal-1 { grid-column:span 2; grid-row:span 2 } .gal-2 { grid-column:span 1; grid-row:span 1 } .gal-3 { grid-column:span 1; grid-row:span 1 } .gal-4 { grid-column:span 1; grid-row:span 1 } .gal-5 { grid-column:span 1; grid-row:span 1 } .gal-6 { grid-column:span 2; grid-row:span 1 }

/* 4. Process */
.proc-section { position:relative; background:var(--navy-deep); padding:104px 48px; overflow:hidden; }
.proc-section .sec-h { color:#fff } .proc-section .sec-sub { color:rgba(255,255,255,.55) } .proc-section .sec-label { color:var(--gold) } .proc-section .sec-label::before, .proc-section .sec-label::after { background:var(--gold) }
.proc-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:22px; position:relative; z-index:2; }
.proc-step { position:relative; background:#fff; border:1px solid rgba(0,0,0,.06); border-radius:18px; padding:34px 26px 30px; text-align:left; overflow:hidden; }
.proc-step-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:22px; }
.proc-num { font-family:var(--fh); font-size:2.4rem; line-height:1; color:var(--gold); }
.proc-icon { width:50px; height:50px; border-radius:13px; background:var(--gold-soft); border:1px solid var(--gold-line); display:flex; align-items:center; justify-content:center; }
.proc-icon svg { width:23px; height:23px; fill:none; stroke:var(--gold); stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
.proc-step h4 { font-family:var(--fh); font-size:1.24rem; color:var(--ink); margin-bottom:9px; font-weight:400; line-height:1.2; }
.proc-step p { font-family:var(--fb); font-size:.88rem; color:var(--muted); line-height:1.62; }

/* 5. Why Us */
.why-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.why-card { background:#fff; border-radius:14px; padding:32px 26px; border:1px solid var(--line); }
.why-icon { width:54px; height:54px; border-radius:12px; background:var(--gold-soft); border:1px solid var(--gold-line); display:flex; align-items:center; justify-content:center; margin-bottom:18px; }
.why-icon svg { width:24px; height:24px; stroke:var(--navy); stroke-width:1.8; fill:none }
.why-card h4 { font-family:var(--fh); font-size:1.22rem; color:var(--ink); margin-bottom:10px; font-weight:400; line-height:1.2; }
.why-card p { font-family:var(--fb); font-size:.9rem; color:var(--muted); line-height:1.65; }

/* 6. Testimonials */
.testi-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.testi { background:#fff; border-radius:14px; padding:30px 28px; border:1px solid var(--line); }
.testi-stars { display:flex; gap:3px; margin-bottom:16px } .testi-stars svg { width:16px; height:16px; fill:var(--gold) }
.testi-quote { font-family:var(--fb); font-size:.96rem; line-height:1.7; color:var(--body); margin-bottom:24px; }
.testi-quote::before { content:"\201C"; font-family:var(--fh); font-size:3.4rem; color:var(--gold); line-height:0; display:block; margin-bottom:18px; opacity:.4; }
.testi-author { display:flex; align-items:center; gap:14px; padding-top:18px; border-top:1px solid var(--line); }
.testi-avatar { width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,var(--navy) 0%,#1a1a1a 100%); color:var(--gold); font-family:var(--fh); font-size:1.1rem; display:flex; align-items:center; justify-content:center; border:1px solid var(--gold-line); flex-shrink:0; }
.testi-name { font-family:var(--fb); font-size:.88rem; font-weight:700; color:var(--ink) } .testi-role { font-family:var(--fb); font-size:.76rem; color:var(--muted); margin-top:2px }

/* 7. Story */
.about-section { background:var(--cream); padding:96px 48px; overflow:hidden; }
.about-inner { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:1.05fr 1fr; gap:64px; align-items:center; }
.about-text .sec-label { justify-content:flex-start } .about-text .sec-label::before, .about-text .sec-label::after { display:none }
.about-text .sec-h { margin-bottom:22px }
.about-text p { font-family:var(--fb); font-size:1rem; line-height:1.75; color:var(--body); margin-bottom:18px; }
.about-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:34px; padding-top:30px; border-top:1px solid var(--line2); }
.about-stat-num { font-family:var(--fh); font-size:2.4rem; color:var(--red); line-height:1; margin-bottom:4px; font-weight:400; }
.about-stat-lab { font-family:var(--fb); font-size:.74rem; color:var(--muted); letter-spacing:.14em; text-transform:uppercase; font-weight:600; }
.about-visual { position:relative; aspect-ratio:4/5; border-radius:18px; overflow:hidden; box-shadow:0 30px 70px rgba(0,0,0,.22); }
.about-visual img { width:100%; height:100%; object-fit:cover }
.about-badge { position:absolute; bottom:-22px; right:-22px; width:140px; height:140px; border-radius:50%; background:var(--gold); color:var(--navy); display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:var(--fh); text-align:center; box-shadow:0 14px 36px rgba(1,136,204,.4); border:4px solid var(--cream); z-index:3; }
.about-badge strong { font-size:2rem; line-height:1; display:block; font-weight:400 } .about-badge span { font-family:var(--fb); font-size:.62rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; margin-top:4px }

/* 8. FAQ */
.faq-section { background:#fff; padding:88px 48px }
.faq-inner { max-width:780px; margin:0 auto }
.faq-item { border-bottom:1px solid var(--line2); padding:6px 0; }
.faq-q { width:100%; text-align:left; padding:22px 0; font-family:var(--fh); font-size:1.18rem; color:var(--ink); display:flex; align-items:center; justify-content:space-between; gap:18px; line-height:1.3; font-weight:400; cursor:pointer; background:none; border:none; }
.faq-q-icon { width:28px; height:28px; border-radius:50%; border:1px solid rgba(0,0,0,0.2); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform .3s,background .3s,border-color .3s; }
.faq-q-icon svg { width:12px; height:12px; stroke:var(--ink); stroke-width:2.5; fill:none; transition:transform .3s }
.faq-item.open .faq-q-icon { background:var(--gold); border-color:var(--gold) } .faq-item.open .faq-q-icon svg { transform:rotate(45deg); stroke:#fff; }
.faq-a { max-height:0; overflow:hidden; transition:max-height .4s cubic-bezier(.16,1,.3,1); }
.faq-a-inner { padding:0 0 22px; font-family:var(--fb); font-size:.95rem; line-height:1.7; color:var(--body); }
.faq-item.open .faq-a { max-height:400px }

/* 9. Final CTA */
.final-cta { background:linear-gradient(180deg,var(--navy) 0%,var(--navy-deep) 100%); color:#fff; padding:104px 48px; position:relative; overflow:hidden; text-align:center; }
.final-inner { max-width:780px; margin:0 auto; position:relative; z-index:1 }
.final-inner .sec-label { color:var(--gold); justify-content:center } .final-inner .sec-label::before, .final-inner .sec-label::after { background:var(--gold) }
.final-inner h2 { font-family:var(--fh); font-size:var(--ts-2xl); color:#fff; line-height:1.04; letter-spacing:-.02em; margin-bottom:18px; font-weight:400; }
.final-inner h2 em { font-style:italic; color:var(--gold) }
.final-inner p { font-family:var(--fb); font-size:1.08rem; line-height:1.6; color:rgba(255,255,255,.72); max-width:560px; margin:0 auto 36px; }
.btn-primary { background:var(--gold); color:var(--navy); font-family:var(--fb); font-size:.95rem; font-weight:700; padding:16px 28px; border-radius:10px; display:inline-flex; align-items:center; gap:10px; transition:transform .2s, box-shadow .25s, background .25s; box-shadow:0 8px 24px rgba(1,136,204,.32); text-decoration:none; }
.btn-primary:hover { background:#02a0eb; transform:translateY(-2px) }
.btn-primary svg { width:16px; height:16px; stroke:var(--navy); stroke-width:2.5; fill:none }

@media(max-width: 980px) {
  .types-grid { grid-template-columns:repeat(2,1fr) } .proc-grid { grid-template-columns:repeat(2,1fr) }
  .why-grid { grid-template-columns:repeat(2,1fr) } .testi-grid { grid-template-columns:1fr }
  .about-inner { grid-template-columns:1fr; gap:48px } .gallery-bento { grid-template-columns:repeat(2,1fr) }
}
</style>

