<style>
:root{
  --ts-xl:2.2rem; --navy:#111111; --gold:#0188CC; --red:#0188CC;
  --cream:#ffffff; --cream-deep:#f5f5f5; --ink:#111111; --muted:#666666;
  --line:rgba(0,0,0,.07); --gold-line:rgba(1,136,204,.24);
  --fh:'DM Serif Display',Georgia,serif; --fb:'Inter',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:93%}
body{font-family:var(--fb);background:#fff;color:#333;line-height:1.6;}

.section{padding:88px 48px;position:relative;overflow:hidden}
.section-white{background:#fff}
.sec-head{text-align:center;max-width:680px;margin:0 auto 56px}
.sec-label{display:inline-flex;align-items:center;gap:8px;font-family:var(--fb);font-size:.82rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--red);margin-bottom:16px;}
.sec-label::before{content:"";width:24px;height:1px;background:var(--red);}
.sec-label::after{content:"";width:24px;height:1px;background:var(--red);}
.sec-h{font-family:var(--fh);font-size:var(--ts-xl);color:var(--ink);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px;font-weight:400;}
.sec-h em{font-style:italic;color:var(--red)}
.sec-sub{font-family:var(--fb);font-size:1rem;color:var(--muted);line-height:1.65;max-width:580px;margin:0 auto;}

.types-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.type-card{background:#fff;border-radius:16px;overflow:hidden;border:1px solid var(--line);transition:transform .35s,box-shadow .35s,border-color .3s;display:flex;flex-direction:column;}
.type-card:hover{transform:translateY(-6px);box-shadow:0 24px 48px rgba(0,0,0,.14);border-color:var(--gold-line);}
.type-card-img{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--navy);}
.type-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .8s}
.type-card:hover .type-card-img img{transform:scale(1.06)}
.type-badge{position:absolute;top:14px;left:14px;z-index:2;background:var(--red);color:#fff;font-family:var(--fb);font-size:.62rem;font-weight:700;padding:5px 11px;border-radius:100px;letter-spacing:.16em;text-transform:uppercase;}
.type-card-body{padding:24px 24px 26px;display:flex;flex-direction:column;flex:1}
.type-card h3{font-family:var(--fh);font-size:1.32rem;color:var(--ink);line-height:1.15;margin-bottom:8px;font-weight:400;}
.type-card p{font-family:var(--fb);font-size:.88rem;color:var(--muted);line-height:1.6;margin-bottom:18px;flex:1;}
.type-card-foot{display:flex;align-items:center;padding-top:16px;border-top:1px solid var(--line);}
.type-card-link{font-family:var(--fb);font-size:.78rem;font-weight:700;color:var(--navy);display:inline-flex;align-items:center;gap:5px;text-decoration:none;}
.type-card-link svg{width:12px;height:12px;stroke:currentColor;stroke-width:2.5;fill:none}

@media(max-width:980px){.types-grid{grid-template-columns:repeat(2,1fr);gap:18px}}
@media(max-width:560px){.types-grid{grid-template-columns:1fr;gap:16px}}
</style>

<section class="section section-white">
  <div class="sec-head">
    <span class="sec-label">What We Build</span>
    <h2 class="sec-h">Popular <em>Sign Types</em> We Build</h2>
    <p class="sec-sub">From bold storefront channel letters and LED neon signs to refined acrylic backlit lobby displays, every custom business sign is engineered in our factory.</p>
  </div>
  <div class="types-grid">
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><span class="type-badge">Most Popular</span><img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="Storefront signs" loading="lazy"></div>
      <div class="type-card-body"><h3>Storefront signs</h3><p>Custom-fabricated aluminum channel letter signs with front-lit, halo-lit or combination LED illumination.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><img src="https://i.ibb.co/Z1bRvmFX/1a8bfc475f04e41dc4168ddc673f5e30.jpg" alt="Reception signs" loading="lazy"></div>
      <div class="type-card-body"><h3>Reception &amp; studio signs</h3><p>Soft, premium halo glow that elevates any brand. Push through signs with acrylic faces and stainless steel returns.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><img src="https://i.ibb.co/VcjZ4ZBF/000.png" alt="Medical signs" loading="lazy"></div>
      <div class="type-card-body"><h3>Medical and Clinic signs</h3><p>Ground-level monuments and tall pylon signs engineered for visibility from the road. Stone, masonry and aluminum finishes.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><img src="https://i.ibb.co/jPLvTFk4/Storefronts-2.jpg" alt="Coffee shops" loading="lazy"></div>
      <div class="type-card-body"><h3>Coffee shops and restaurants</h3><p>Lightbox signs, cabinet signs and face-lit fixtures designed for high-traffic main street visibility.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><img src="https://i.ibb.co/tpq229Zx/86e7f4ccec44b08749e3403e5c444a65.jpg" alt="Gym Spa Salon" loading="lazy"></div>
      <div class="type-card-body"><h3>Gym, Spa &amp; Salon signs</h3><p>Photogenic LED neon signs, acrylic backlit logos and dimensional wall signs built for fitness studios.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
    <a href="/pages/sign-types" class="type-card" style="text-decoration:none;color:inherit;">
      <div class="type-card-img"><img src="https://i.ibb.co/JFC3PgnK/2d-metal-5mm-image-2.jpg" alt="Lobby Interior" loading="lazy"></div>
      <div class="type-card-body"><h3>Lobby &amp; Interior Signs</h3><p>Reception walls, dimensional logo signs and indoor directional signs in brushed aluminum, backlit metal, acrylic and neon.</p><div class="type-card-foot"><span class="type-card-link">Explore Types <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></div></div>
    </a>
  </div>
</section>

