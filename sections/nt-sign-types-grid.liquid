<!-- sections/nt-sign-types-grid.liquid -->
<style>
  :root {
    --fh: 'DM Serif Display', Georgia, serif;
    --fb: 'Inter', system-ui, sans-serif;
    --accent: #0188cc;
    --acch: #016da0;
    --ink: #111111;
    --body: #333333;
    --muted: #666666;
  }

  .nt-signs-section {
    background: #f5f7fa;
    padding: 80px 20px;
    font-family: var(--fb);
  }
  .nt-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .nt-head {
    text-align: center;
    margin-bottom: 50px;
  }
  .nt-head h2 {
    font-family: var(--fh);
    font-size: 2.5rem;
    color: var(--ink);
    margin-bottom: 10px;
    font-weight: 400;
  }
  .nt-head h2 em {
    color: var(--accent);
    font-style: italic;
  }
  .nt-head p {
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .nt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .nt-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #e0e0e0;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .nt-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
    border-color: var(--accent);
  }

  .nt-card-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #eee;
  }
  .nt-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .nt-card:hover .nt-card-img {
    transform: scale(1.05);
  }
  .nt-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0,0,0,0.6);
    color: #fff;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .nt-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .nt-card-title {
    font-family: var(--fh);
    font-size: 1.25rem;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .nt-card-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 15px;
    flex: 1;
  }
  .nt-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .nt-tag {
    background: #f0f0f0;
    color: #555;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .nt-btns {
    display: flex;
    gap: 10px;
  }
  .nt-btn {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    border: 1.5px solid transparent;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .nt-btn-outline {
    border-color: var(--accent);
    color: var(--accent);
    background: #fff;
  }
  .nt-btn-outline:hover {
    background: #f0f7fb;
  }
  .nt-btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
  }
  .nt-btn-primary:hover {
    background: var(--acch);
  }

  /* Modal Form Styles */
  .nt-modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    z-index: 9999;
    justify-content: center;
    align-items: flex-start;
    padding: 40px 20px;
    overflow-y: auto;
  }
  .nt-modal-overlay.active {
    display: flex;
  }
  .nt-modal-box {
    background: #fff;
    max-width: 500px;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    animation: slideDown 0.3s ease;
  }
  @keyframes slideDown {
    from { transform: translateY(-30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .nt-modal-head {
    background: var(--accent);
    color: #fff;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nt-modal-head h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }
  .nt-modal-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }
  .nt-modal-body {
    padding: 24px;
  }
  .nt-form-group {
    margin-bottom: 16px;
  }
  .nt-form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
    margin-bottom: 6px;
  }
  .nt-form-group input, .nt-form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1.5px solid #ddd;
    border-radius: 8px;
    font-family: var(--fb);
    font-size: 0.95rem;
    box-sizing: border-box;
  }
  .nt-form-group input:focus, .nt-form-group textarea:focus {
    border-color: var(--accent);
    outline: none;
  }
  .nt-submit-btn {
    width: 100%;
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 10px;
  }
  .nt-submit-btn:hover {
    background: var(--acch);
  }
</style>

