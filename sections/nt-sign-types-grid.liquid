<!-- Quote Modal -->
<div class="nt-modal-overlay" id="ntSignModal" onclick="closeSignModal(event)">
  <div class="nt-modal-box" onclick="event.stopPropagation()">
    <div class="nt-modal-head">
      <h3>Get Quote for <span id="ntModalSignName">Sign</span></h3>
      <button class="nt-modal-close" onclick="closeSignModalDirect()">&times;</button>
    </div>
    <div class="nt-modal-body">
      <form action="/contact#ContactForm" method="post">
        <input type="hidden" id="ntSignNameInput" name="Sign Type">
        
        <div class="nt-form-group">
          <label>Your Name *</label>
          <input type="text" name="name" placeholder="John Doe" required>
        </div>
        
        <div class="nt-form-group">
          <label>Email Address *</label>
          <input type="email" name="email" placeholder="you@example.com" required>
        </div>
        
        <div class="nt-form-group">
          <label>Phone Number</label>
          <input type="tel" name="phone" placeholder="(555) 123-4567">
        </div>
        
        <div class="nt-form-group">
          <label>Sign Details</label>
          <textarea name="details" rows="3" placeholder="Size, color, installation location..."></textarea>
        </div>

        <div class="nt-form-group">
          <label>Upload Logo (Optional)</label>
          <input type="file" name="logo" accept="image/*,.pdf,.ai,.eps">
        </div>

        <button type="submit" class="nt-submit-btn">Submit Request</button>
      </form>
    </div>
  </div>
</div>

<script>
  function openSignModal(signName) {
    var modal = document.getElementById('ntSignModal');
    var nameSpan = document.getElementById('ntModalSignName');
    var nameInput = document.getElementById('ntSignNameInput');
    
    nameSpan.textContent = signName;
    nameInput.value = signName;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden'; // Prevent background scroll
  }

  function closeSignModal(event) {
    if (event.target.id === 'ntSignModal') {
      var modal = document.getElementById('ntSignModal');
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  }

  function closeSignModalDirect() {
    var modal = document.getElementById('ntSignModal');
    modal.classList.remove('active');
    document.body.style.overflow = 'auto';
  }
  
  document.addEventListener('keydown', function(event) {
    if(event.key === "Escape") {
      closeSignModalDirect();
    }
  });
</script>

