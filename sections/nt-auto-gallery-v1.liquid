<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.nt-gal-item').forEach(item => {
      const cycles = item.querySelectorAll('.nt-gal-cycle');
      if (cycles.length > 1) {
        let current = 0;
        setInterval(() => {
          cycles[current].classList.remove('active');
          current = (current + 1) % cycles.length;
          cycles[current].classList.add('active');
        }, 3000); // Changes image every 3 seconds automatically
      }
    });
  });
</script>

