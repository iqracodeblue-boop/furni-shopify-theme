<style>
:root{
  --ts-xl:2.2rem; --red:#0188CC; --gold:#0188CC; --navy:#111111; --ink:#111111; --muted:#666666;
  --fh:'DM Serif Display',Georgia,serif; --fb:'Inter',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:93%}
body{font-family:var(--fb);background:#fff;color:#333;line-height:1.6;}

.nt-gallery-section{padding:88px 48px;background:#fff}
.nt-sec-head{text-align:center;max-width:680px;margin:0 auto 56px}
.nt-sec-label{display:inline-flex;align-items:center;gap:8px;font-family:var(--fb);font-size:.82rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--red);margin-bottom:16px;}
.nt-sec-label::before{content:"";width:24px;height:1px;background:var(--red);}
.nt-sec-label::after{content:"";width:24px;height:1px;background:var(--red);}
.nt-sec-h{font-family:var(--fh);font-size:var(--ts-xl);color:var(--ink);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px;font-weight:400;}
.nt-sec-h em{font-style:italic;color:var(--red)}
.nt-sec-sub{font-family:var(--fb);font-size:1rem;color:var(--muted);line-height:1.65;max-width:580px;margin:0 auto;}

/* Uniform Grid (3 Columns, Same Size) */
.nt-uniform-grid{
  max-width:1100px;margin:0 auto;
  display:grid !important;
  grid-template-columns:repeat(3, 1fr) !important;
  gap:20px !important;
}
.nt-gal-item{
  position:relative !important;
  overflow:hidden !important;
  border-radius:12px !important;
  background:#111 !important;
  cursor:pointer !important;
  aspect-ratio: 4/3 !important; /* Yeh sab images ka size same rakhega */
}

/* Image Sliding CSS */
.nt-gal-cycle{position:absolute !important;top:0 !important;left:0 !important;width:100% !important;height:100% !important;opacity:0;transition:opacity 1s ease;z-index:1;}
.nt-gal-cycle.active{opacity:1;z-index:2}
.nt-gal-cycle img{max-width:100% !important;width:100% !important;height:100% !important;object-fit:cover !important;display:block !important;}

.nt-gal-item::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.85) 100%);opacity:.9;z-index:3;pointer-events:none;}
.nt-gal-cap{position:absolute;left:15px;right:15px;bottom:15px;z-index:4;color:#fff;font-family:var(--fh);font-size:1.1rem;line-height:1.2;}
.nt-gal-cap small{display:block;font-family:var(--fb);font-size:.7rem;font-weight:500;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px;}

/* Bottom CTA Button */
.nt-cta-wrap{text-align:center;margin-top:48px;}
.nt-cta-btn{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--gold);color:#fff !important;
  font-family:var(--fb);font-size:.95rem;font-weight:700;
  padding:14px 28px;border-radius:8px;
  text-decoration:none;
  transition:transform .2s,background .2s;
}
.nt-cta-btn:hover{background:#0170a8;transform:translateY(-2px);}
.nt-cta-btn svg{width:16px;height:16px;stroke:#fff;stroke-width:2.5;fill:none}

@media(max-width:880px){
  .nt-uniform-grid{grid-template-columns:repeat(2, 1fr) !important;}
}
@media(max-width:560px){
  .nt-uniform-grid{grid-template-columns:1fr !important;}
}
</style>

