<!-- sections/nt-faq-v1.liquid -->
<style>
  :root {
    --fh: 'DM Serif Display', Georgia, serif;
    --fb: 'Inter', system-ui, sans-serif;
    --accent: #0188cc;
    --ink: #111111;
    --muted: #666666;
  }

  .nt-faq-section {
    background: #fff;
    padding: 88px 48px;
    font-family: var(--fb);
  }
  @media (max-width: 768px) {
    .nt-faq-section { padding: 64px 24px; }
  }

  .nt-faq-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }
  .nt-sec-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .nt-sec-label::before, .nt-sec-label::after {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--accent);
  }
  .nt-faq-head h2 {
    font-family: var(--fh);
    font-size: clamp(2.2rem, 5vw, 2.8rem);
    color: var(--ink);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .nt-faq-head h2 em {
    font-style: italic;
    color: var(--accent);
    font-family: var(--fh);
  }
  .nt-faq-head p {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 580px;
    margin: 0 auto;
  }

  .nt-faq-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .nt-faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding: 6px 0;
  }

  .nt-faq-q {
    width: 100%;
    text-align: left;
    padding: 22px 0;
    font-family: var(--fh);
    font-size: 1.18rem;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    line-height: 1.3;
    font-weight: 400;
    transition: color 0.2s;
    background: none;
    border: none;
    cursor: pointer;
  }
  .nt-faq-q:hover {
    color: var(--accent);
  }

  .nt-faq-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s, background 0.3s, border-color 0.3s;
  }
  .nt-faq-icon svg {
    width: 12px;
    height: 12px;
    stroke: #111;
    stroke-width: 2.5;
    fill: none;
    transition: transform 0.3s;
  }

  .nt-faq-item.open .nt-faq-icon {
    background: var(--accent);
    border-color: var(--accent);
  }
  .nt-faq-item.open .nt-faq-icon svg {
    transform: rotate(45deg); /* Turns + into x */
    stroke: #fff;
  }

  .nt-faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nt-faq-a-inner {
    padding: 0 0 22px;
    font-family: var(--fb);
    font-size: 0.95rem;
    line-height: 1.7;
    color: #333;
  }
  .nt-faq-item.open .nt-faq-a {
    max-height: 400px; /* Enough for the longest answer */
  }
</style>

<section class="nt-faq-section" id="faq">
  <div class="nt-faq-head">
    <span class="nt-sec-label">Common Questions</span>
    <h2>Frequently <em>Asked</em></h2>
    <p>Everything business owners ask before placing their first order with us.</p>
  </div>
  
  <div class="nt-faq-inner">
    <!-- Q1 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        How long does it take to get a custom sign made?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Most custom signs are designed, manufactured and shipped within 10 to 14 business days. You will receive a free digital mockup within 2 hours of submitting your details so production can begin as soon as you approve the design. Rush options are available on most products.
        </div>
      </div>
    </div>

    <!-- Q2 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        Do you install signs across all 50 states?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Yes. Signs.inc has a vetted network of licensed, insured professional installers in all 50 states. We handle site surveys, permit guidance, installation and post-install support nationwide. From Maine to Maui, your sign goes up the right way.
        </div>
      </div>
    </div>

    <!-- Q3 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        What kind of warranty do you offer?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Every sign we manufacture is covered by a 2-years warranty on electrical components, LED modules and structural integrity. We use UL-listed power supplies, commercial-grade LEDs and weather-rated materials built to last in any climate.
        </div>
      </div>
    </div>

    <!-- Q4 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        Are your signs UL listed?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Yes. Our illuminated signs are built to UL 48 standards using UL-recognized components, which is required for most commercial sign permits in the United States. We can provide UL paperwork as part of your permit package on request.
        </div>
      </div>
    </div>

    <!-- Q5 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        How much does a custom storefront sign cost?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Pricing depends on size, lighting type, materials and installation requirements. Most storefront channel letter signs fall between $1,800 and $6,500 including installation. Monument signs typically start at $4,500. Submit your details for a free, no-obligation quote and mockup within 2 hours.
        </div>
      </div>
    </div>

    <!-- Q6 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        Can you help with permits?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Yes. While the property owner is typically the permit holder, we provide engineered drawings, UL documentation and installer support so your local sign permit application moves smoothly. We have helped clients secure permits in nearly every major US city.
        </div>
      </div>
    </div>

    <!-- Q7 -->
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="ntToggleFaq(this)">
        What sign types and materials do you offer?
        <span class="nt-faq-icon">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </button>
      <div class="nt-faq-a">
        <div class="nt-faq-a-inner">
          Quite a few. We manufacture backlit channel letters, frontlit and backlit signs, 2D metal acrylic signs, laser cut metal signs and laser cut acrylic signs, push through signs, LED neon signs and custom neon signs, indoor office signs, indoor directional signs, moss signs, pylon signs, marquee signs and outdoor blade projecting signs. If your business needs a custom metal sign outdoor or an outdoor backlit sign for round-the-clock visibility, we build that too. Tell us your sign type when you request a quote and we will match the right material and lighting to your space.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function ntToggleFaq(btn) {
    var item = btn.parentElement;
    // Close all other items
    document.querySelectorAll('.nt-faq-item').forEach(function(el) {
      if (el !== item) {
        el.classList.remove('open');
      }
    });
    // Toggle the clicked item
    item.classList.toggle('open');
  }
</script>

