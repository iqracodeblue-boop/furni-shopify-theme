  // 2. Render Categories Function
  function renderCategories() {
    let html = '';
    NT_CATS.forEach(cat => {
      html += `
        <div class="nt-cat-card" onclick="showSigns('${cat.id}')">
          <div class="nt-cat-img-wrap">
            <img src="${cat.img}" alt="${cat.name}" class="nt-cat-img" loading="lazy">
            <span class="nt-cat-count"><b>${cat.count}</b> sign types</span>
          </div>
          <div class="nt-cat-body">
            <h3 class="nt-cat-title">${cat.name}</h3>
            <p class="nt-cat-desc">${cat.desc}</p>
            <button class="nt-explore-btn">Explore Types →</button>
          </div>
        </div>
      `;
    });
    document.getElementById('ntCatGrid').innerHTML = html;
  }

  // 3. Show Signs Function (When Category is clicked)
  function showSigns(catId) {
    const cat = NT_CATS.find(c => c.id === catId);
    if (!cat) return;

    let signsHtml = '';
    cat.signs.forEach(sign => {
      signsHtml += `
        <div class="nt-sign-card">
          <div class="nt-sign-img-wrap">
            <img src="${sign.img}" alt="${sign.name}" class="nt-sign-img" loading="lazy">
            <span class="nt-sign-badge">${sign.badge}</span>
          </div>
          <div class="nt-sign-body">
            <h3 class="nt-sign-title">${sign.name}</h3>
            <p class="nt-sign-desc">${sign.desc}</p>
            <div class="nt-sign-tags">
              ${sign.tags.map(t => `<span class="nt-tag">${t}</span>`).join('')}
            </div>
            <div class="nt-sign-btns">
              <a href="#" class="nt-btn nt-btn-outline">View Designs</a>
              <button class="nt-btn nt-btn-primary" onclick="openSignModal('${sign.name}')">Get Quote</button>
            </div>
          </div>
        </div>
      `;
    });

    document.getElementById('ntPanelTitle').innerText = cat.name;
    document.getElementById('ntSignGrid').innerHTML = signsHtml;
    
    document.getElementById('ntCatGrid').style.display = 'none';
    document.getElementById('ntSignsPanel').style.display = 'block';
    window.scrollTo({ top: document.getElementById('ntSignsPanel').offsetTop - 100, behavior: 'smooth' });
  }

  // 4. Back to Categories Function
  function showCategories() {
    document.getElementById('ntSignsPanel').style.display = 'none';
    document.getElementById('ntCatGrid').style.display = 'grid';
    window.scrollTo({ top: document.getElementById('ntCatGrid').offsetTop - 100, behavior: 'smooth' });
  }

  // 5. Modal Functions
  function openSignModal(signName) {
    var modal = document.getElementById('ntSignModal');
    document.getElementById('ntModalSignName').textContent = signName;
    document.getElementById('ntSignNameInput').value = signName;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeSignModal(event) {
    if (event.target.id === 'ntSignModal') {
      document.getElementById('ntSignModal').classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  }
  function closeSignModalDirect() {
    document.getElementById('ntSignModal').classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', function() {
    renderCategories();
    document.addEventListener('keydown', function(event) {
      if(event.key === "Escape") closeSignModalDirect();
    });
  });
</script>

