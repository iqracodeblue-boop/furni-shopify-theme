  </div>
  <div class="gallery-bento">
    <div class="gal-item gal-1">
      <div class="gal-cycle active"><img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="Storefront"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/7Nd52czm/nw-Hr-L.jpg" alt="Halo Lit"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/6RbfyDF0/lobby-and-reception.jpg" alt="Lobby"></div>
      <div class="gal-cap"><small>Sign Type</small>Storefront Signs</div>
    </div>
    <div class="gal-item gal-2">
      <div class="gal-cycle active"><img src="https://i.ibb.co/2mRQ7Y0/e0cc8c5e140f122c969efb850e696e44.jpg" alt="UV Acrylic"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/1Gp76c58/cb25442aad4c8435bb11a509ccc4b132.jpg" alt="Brushed Metal"></div>
      <div class="gal-cap"><small>Sign Type</small>UV Acrylic</div>
    </div>
    <div class="gal-item gal-3">
      <div class="gal-cycle active"><img src="https://i.ibb.co/0yr2R8DZ/7ed75f6621c0989e3478f26da0a8cec3-1.jpg" alt="Front Lit"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/B2JQnr6N/74d052ff-c4ee-4cb5-ac7e-183dcb40f0e2.png" alt="Raceway"></div>
      <div class="gal-cap"><small>Sign Type</small>Acrylic Front Lit</div>
