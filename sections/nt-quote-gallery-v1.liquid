    <div class="gal-item gal-4">
      <div class="gal-cycle active"><img src="https://i.ibb.co/Xk7kC7sZ/9bc0a390bd5f595c29ed220f1af96cc1.jpg" alt="Lightbox"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/Kcxh3wsG/open-face-neon.png" alt="Neon"></div>
