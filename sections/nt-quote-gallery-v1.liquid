<style>
:root{
  --ts-xl:2.2rem; --red:#0188CC; --gold:#0188CC; --navy:#111111; --ink:#111111; --muted:#666666;
  --fh:'DM Serif Display',Georgia,serif; --fb:'Inter',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:93%}
body{font-family:var(--fb);background:#fff;color:#333;line-height:1.6;}

.section{padding:88px 48px;background:#fff}
.sec-head{text-align:center;max-width:680px;margin:0 auto 56px}
.sec-label{display:inline-flex;align-items:center;gap:8px;font-family:var(--fb);font-size:.82rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--red);margin-bottom:16px;}
.sec-label::before{content:"";width:24px;height:1px;background:var(--red);}
.sec-label::after{content:"";width:24px;height:1px;background:var(--red);}
.sec-h{font-family:var(--fh);font-size:var(--ts-xl);color:var(--ink);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px;font-weight:400;}
.sec-h em{font-style:italic;color:var(--red)}
.sec-sub{font-family:var(--fb);font-size:1rem;color:var(--muted);line-height:1.65;max-width:580px;margin:0 auto;}

.gallery-bento{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:200px;gap:14px;}
.gal-item{position:relative;overflow:hidden;border-radius:14px;background:#111;cursor:pointer;}

/* Bulletproof Image Cycle CSS */
.gal-cycle{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;transition:opacity 1.1s cubic-bezier(.16,1,.3,1);z-index:1;}
.gal-cycle.active{opacity:1;z-index:2}
.gal-cycle img{width:100%;height:100%;object-fit:cover;display:block;}
  
.gal-item::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.78) 100%);opacity:.85;z-index:3;pointer-events:none;}
.gal-cap{position:absolute;left:18px;right:18px;bottom:16px;z-index:4;color:#fff;font-family:var(--fh);font-size:1.05rem;line-height:1.2;}
.gal-cap small{display:block;font-family:var(--fb);font-size:.7rem;font-weight:500;color:var(--gold);letter-spacing:.14em;text-transform:uppercase;margin-bottom:4px;}

.gal-1{grid-column:span 2;grid-row:span 2} 
.gal-2{grid-column:span 1;grid-row:span 1} 
.gal-3{grid-column:span 1;grid-row:span 1} 
.gal-4{grid-column:span 1;grid-row:span 1} 
.gal-5{grid-column:span 1;grid-row:span 1} 
.gal-6{grid-column:span 2;grid-row:span 1}

@media(max-width:880px){.gallery-bento{grid-template-columns:repeat(2,1fr);grid-auto-rows:160px}.gal-1{grid-column:span 2;grid-row:span 1}.gal-6{grid-column:span 2}}
@media(max-width:480px){.gallery-bento{grid-template-columns:1fr;grid-auto-rows:200px;gap:10px}.gal-1,.gal-6{grid-column:span 1}}
</style>

<section class="section">
  <div class="sec-head">
    <span class="sec-label">Our Work</span>
    <h2 class="sec-h">Our Most <em>Recent Projects.</em></h2>
    <p class="sec-sub">All of our signs are built in our factory and professionally installed. No stock photos.</p>
  </div>
  <div class="gallery-bento">
    
    <div class="gal-item gal-1">
      <div class="gal-cycle active"><img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="HotRocks Grill"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/wZJPVMTC/IMG-1229.jpg" alt="Warm White Halo"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/6RbfyDF0/lobby-and-reception.jpg" alt="Lobby"></div>
      <div class="gal-cap"><small>Brooklyn, NY</small>HotRocks Grill</div>
    </div>
    
    <div class="gal-item gal-2">
      <div class="gal-cycle active"><img src="https://i.ibb.co/fLZ1FSz/3d-metal-nonlit-1.jpg" alt="PRAY LOVE"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/8LCWzbdF/dc5ad4413068e1428de033d30ef822c0.jpg" alt="2mm Flat-Cut"></div>
      <div class="gal-cap"><small>Seattle, WA</small>PRAY LOVE</div>
    </div>
    
    <div class="gal-item gal-3">
      <div class="gal-cycle active"><img src="https://i.ibb.co/27R8x8DX/3d-acrylic-frontlit-image-1-1.png" alt="CAFE"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/B2JQnr6N/74d052ff-c4ee-4cb5-ac7e-183dcb40f0e2.png" alt="Front-Lit with Raceway"></div>
      <div class="gal-cap"><small>Tampa, FL</small>CAFE</div>
    </div>
    
    <div class="gal-item gal-4">
      <div class="gal-cycle active"><img src="https://i.ibb.co/ymwCTPF0/3d-metal-backlit-2.jpg" alt="NTREPID"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/DH0FFQCd/66793f20edb71e28c00f7e453b711b46.jpg" alt="Backlit with Backboard"></div>
      <div class="gal-cap"><small>Nashville, TN</small>NTREPID</div>
    </div>
    
    <div class="gal-item gal-5">
      <div class="gal-cycle active"><img src="https://i.ibb.co/1fX1Jpsn/uv-acrylic-1.jpg" alt="toptooth"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/hFCfRXYg/uv-neon-acrylic-1.jpg" alt="UV Neon Acrylic"></div>
      <div class="gal-cap"><small>San Diego, CA</small>toptooth</div>
    </div>
    
    <div class="gal-item gal-6">
      <div class="gal-cycle active"><img src="https://i.ibb.co/yBP4T6Qn/3-D-blade-sign-1.jpg" alt="The DUTCH"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/KtbtvFN/2d-blade-sign-image-1.jpg" alt="2D Flat Blade"></div>
      <div class="gal-cap"><small>Savannah, GA</small>The DUTCH</div>
    </div>
    
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.gal-item').forEach(item => {
      const cycles = item.querySelectorAll('.gal-cycle');
      if (cycles.length > 1) {
        let current = 0;
        setInterval(() => {
          cycles[current].classList.remove('active');
          current = (current + 1) % cycles.length;
          cycles[current].classList.add('active');
        }, 3000); // Changes image every 3 seconds
      }
    });
  });
</script>

{% schema %}
