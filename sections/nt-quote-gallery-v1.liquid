      <div class="gal-cycle active"><img src="https://i.ibb.co/VcjZ4ZBF/000.png" alt="Medical"></div>
      <div class="gal-cycle"><img src="https://i.ibb.co/SXNv5mwS/directional-and-monument-1.jpg" alt="Directional"></div>
