<!-- CHATBOT FAB & WINDOW -->
<button class="nt-chat-fab" id="ntChatFab" onclick="ntToggleChat()">
  <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
</button>

<div class="nt-chat-window" id="ntChatWindow">
  <div class="nt-chat-header">
    <div class="nt-chat-header-avatar">S</div>
    <div class="nt-chat-header-info">
      <h4>Signs.Inc</h4>
      <span>Typically replies in 1 minute</span>
    </div>
    <button class="nt-chat-close" onclick="ntToggleChat()">&times;</button>
  </div>
  <div class="nt-chat-body" id="ntChatBody">
    <div class="nt-chat-msg">
      Hello! How can I assist you today? I'm here to help you with your custom sign design needs.
      <div class="nt-chat-time">Just now</div>
    </div>
  </div>
  <div class="nt-chat-input">
    <input type="text" id="ntChatInput" placeholder="Type your message here..." onkeypress="ntHandleChat(event)">
    <button onclick="ntSendMessage()"><svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg></button>
  </div>
</div>

<script>
  function ntToggleChat() {
    var win = document.getElementById('ntChatWindow');
    win.classList.toggle('active');
  }
  
  function ntSendMessage() {
    var input = document.getElementById('ntChatInput');
    var body = document.getElementById('ntChatBody');
    if(input.value.trim() === '') return;
    
    // User Msg
    var userMsg = document.createElement('div');
    userMsg.className = 'nt-chat-msg';
    userMsg.style.background = '#0188cc';
    userMsg.style.color = '#fff';
    userMsg.style.borderRadius = '12px 12px 0 12px';
    userMsg.style.alignSelf = 'flex-end';
    userMsg.innerHTML = input.value + '<div class="nt-chat-time" style="text-align:right; color:rgba(255,255,255,0.7)">Just now</div>';
    body.appendChild(userMsg);
    
    input.value = '';
    body.scrollTop = body.scrollHeight;
    
    // Auto Reply
    setTimeout(function() {
      var botMsg = document.createElement('div');
      botMsg.className = 'nt-chat-msg';
      botMsg.innerHTML = 'Thanks for reaching out! Our team will get back to you shortly. For immediate assistance, call +1 205 900 7525. <div class="nt-chat-time">Just now</div>';
      body.appendChild(botMsg);
      body.scrollTop = body.scrollHeight;
    }, 1000);
  }
  
  function ntHandleChat(e) {
    if(e.key === 'Enter') ntSendMessage();
  }
</script>

