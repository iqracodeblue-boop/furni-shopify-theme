<style>
/* Bulletproof CSS to prevent Shopify theme overrides */
#shopify-section-nt-quote-final-v1, #shopify-section-nt-quote-final {
  margin: 0 !important; padding: 0 !important; max-width: 100% !important; width: 100% !important;
}
.ntq-wrap {
  display: grid !important;
  grid-template-columns: 1fr 1.2fr !important;
  min-height: 90vh !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}
@media(max-width: 880px) {
  .ntq-wrap { grid-template-columns: 1fr !important; min-height: auto !important; }
}

/* Left Side */
.ntq-left {
  background-color: #0a0a0a !important;
  background-image: radial-gradient(ellipse 60% 40% at 20% 20%, rgba(1,136,204,0.15) 0%, transparent 60%) !important;
  color: #fff !important;
  padding: 60px 50px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}
.ntq-badge {
  display: inline-flex !important; align-items: center !important; gap: 8px !important; background: rgba(1,136,204,.12) !important;
  border: 1px solid rgba(1,136,204,.3) !important; padding: 8px 14px !important; border-radius: 50px !important;
  font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; color: #0188CC !important; margin-bottom: 30px !important; width: fit-content !important;
}
.ntq-left h1 { font-family: 'DM Serif Display', serif !important; font-size: 2.4rem !important; line-height: 1.1 !important; margin-bottom: 20px !important; font-weight: 400 !important; color: #fff !important; }
.ntq-left h1 em { color: #0188CC !important; font-style: italic !important; }
.ntq-desc { font-size: 1rem !important; color: rgba(255,255,255,0.7) !important; margin-bottom: 30px !important; line-height: 1.6 !important; max-width: 90% !important; }
.ntq-sign-list { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 15px !important; }
.ntq-sign-item { display: flex !important; align-items: center !important; gap: 10px !important; background: rgba(255,255,255,0.03) !important; padding: 8px !important; border-radius: 10px !important; border: 1px solid rgba(255,255,255,0.08) !important; }
.ntq-sign-item img { width: 50px !important; height: 50px !important; object-fit: cover !important; border-radius: 8px !important; }
.ntq-sign-item span { font-size: 0.85rem !important; font-weight: 600 !important; color: #fff !important; }

/* Right Side */
.ntq-right { background: #f4f7fa !important; padding: 50px 40px !important; display: flex !important; flex-direction: column !important; justify-content: center !important; position: relative !important; box-sizing: border-box !important; }
.ntq-ship-badge { position: absolute !important; top: 20px !important; right: 20px !important; background: #0188CC !important; color: #fff !important; padding: 6px 14px !important; border-radius: 20px !important; font-size: 0.7rem !important; font-weight: 700 !important; text-transform: uppercase !important; }
.ntq-form-card { background: #fff !important; padding: 40px !important; border-radius: 16px !important; box-shadow: 0 20px 50px rgba(0,0,0,0.08) !important; border: 1px solid rgba(0,0,0,0.05) !important; box-sizing: border-box !important; }
.ntq-form-header h2 { font-family: 'DM Serif Display', serif !important; font-size: 2rem !important; margin-bottom: 8px !important; font-weight: 400 !important; color: #111 !important; }
.ntq-form-header h2 em { color: #0188CC !important; font-style: italic !important; }
.ntq-form-header p { font-size: 0.9rem !important; color: #666 !important; margin-bottom: 25px !important; }

.ntq-row { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 14px !important; margin-bottom: 14px !important; }
.ntq-field { display: flex !important; flex-direction: column !important; }
.ntq-field.full { grid-column: span 2 !important; }
.ntq-label { font-family: 'Inter', sans-serif !important; font-size: 0.74rem !important; font-weight: 700 !important; color: #111 !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; margin-bottom: 7px !important; }
.ntq-label .req { color: #0188CC !important; }
.ntq-input, .ntq-select, .ntq-textarea { font-family: 'Inter', sans-serif !important; font-size: 0.92rem !important; padding: 13px 14px !important; border-radius: 9px !important; border: 1.5px solid rgba(0,0,0,.12) !important; background: #f9f9f9 !important; color: #111 !important; width: 100% !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s !important; }
.ntq-input:focus, .ntq-select:focus, .ntq-textarea:focus { border-color: #0188CC !important; background: #fff !important; box-shadow: 0 0 0 4px rgba(1,136,204,.14) !important; }
.ntq-textarea { resize: vertical !important; min-height: 80px !important; }
.ntq-file-wrap { position: relative !important; border: 1.5px dashed rgba(0,0,0,.12) !important; border-radius: 9px !important; padding: 14px !important; text-align: center !important; background: #f9f9f9 !important; cursor: pointer !important; height: 100% !important; box-sizing: border-box !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.ntq-file-wrap:hover { border-color: #0188CC !important; }
.ntq-file-wrap input[type="file"] { position: absolute !important; inset: 0 !important; opacity: 0 !important; cursor: pointer !important; width: 100% !important; height: 100% !important; }
.ntq-file-label { font-size: 0.85rem !important; color: #666 !important; display: flex !important; align-items: center !important; justify-content: center !important; gap: 8px !important; }
.ntq-file-label svg { width: 18px !important; height: 18px !important; stroke: #0188CC !important; fill: none !important; stroke-width: 2 !important; }

.ntq-submit { width: 100% !important; background: #0188CC !important; color: #fff !important; font-family: 'Inter', sans-serif !important; font-size: 0.95rem !important; font-weight: 700 !important; padding: 16px !important; border-radius: 10px !important; margin-top: 10px !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 10px !important; cursor: pointer !important; border: none !important; transition: background 0.2s !important; text-transform: uppercase !important; letter-spacing: 0.02em !important; }
.ntq-submit:hover { background: #0170a8 !important; }
.ntq-submit svg { width: 16px !important; height: 16px !important; stroke: #fff !important; stroke-width: 2.5 !important; fill: none !important; }

.ntq-trust { margin-top: 25px !important; text-align: center !important; }
.ntq-trust p { font-size: 0.8rem !important; color: #666 !important; margin-bottom: 5px !important; display: flex !important; align-items: center !important; justify-content: center !important; gap: 6px !important; }
.ntq-trust p strong { color: #111 !important; }
.ntq-trust p svg { width: 14px !important; height: 14px !important; stroke: #0188CC !important; fill: none !important; stroke-width: 2 !important; }
</style>

<div class="ntq-wrap">
  <!-- Left Side -->
  <div class="ntq-left">
    <div class="ntq-badge">
      <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#0188CC;fill:none;stroke-width:2.5;"><path d="M12 2l3 7h7l-6 4.5L18 22l-6-4-6 4 2-8.5L2 9h7z"/></svg>
      Free mockup in 2 hours - No obligation
    </div>
    <h1>Custom 3D business signs. <em>Free quote & mockup.</em></h1>
    <p class="ntq-desc">We build premium custom 3D signs tailored to your brand. From storefront channel letters to illuminated monuments, we deliver quality signage for indoor and outdoor use. Upload your logo for a free mockup & quote.</p>
    
    <div class="ntq-sign-list">
      <div class="ntq-sign-item"><img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="3D Metal Backlit"><span>3D Metal Backlit</span></div>
      <div class="ntq-sign-item"><img src="https://i.ibb.co/0yr2R8DZ/7ed75f6621c0989e3478f26da0a8cec3-1.jpg" alt="Acrylic Front Lit"><span>Acrylic Front Lit</span></div>
      <div class="ntq-sign-item"><img src="https://i.ibb.co/Xk7kC7sZ/9bc0a390bd5f595c29ed220f1af96cc1.jpg" alt="Lightbox Signs"><span>Lightbox Signs</span></div>
      <div class="ntq-sign-item"><img src="https://i.ibb.co/Z1bRvmFX/1a8bfc475f04e41dc4168ddc673f5e30.jpg" alt="Halo Lit Letters"><span>Halo Lit Letters</span></div>
      <div class="ntq-sign-item"><img src="https://i.ibb.co/7Nd52czm/nw-Hr-L.jpg" alt="Channel Letters"><span>Channel Letters</span></div>
      <div class="ntq-sign-item"><img src="https://i.ibb.co/Txv6T1Xs/73a77a70eba24d8090295aa71ab1a4c5.jpg" alt="Push Thru Signs"><span>Push Thru Signs</span></div>
    </div>
  </div>

  <!-- Right Side -->
  <div class="ntq-right">
    <div class="ntq-ship-badge">FREE SHIPPING to all 50 States</div>
    
    <div class="ntq-form-card">
      <div class="ntq-form-header">
        <h2>Get a Free <em>Mockup in 2 Hours.</em></h2>
        <p>Tell us a little about your business and the sign you have in mind.</p>
      </div>
      
      <form onsubmit="event.preventDefault();alert('Request Sent! We will send your mockup within 2 hours.');this.reset();">
        <div class="ntq-row">
          <div class="ntq-field"><label class="ntq-label">Full Name <span class="req">*</span></label><input type="text" class="ntq-input" placeholder="John Carter" required></div>
          <div class="ntq-field"><label class="ntq-label">Phone <span class="req">*</span></label><input type="tel" class="ntq-input" placeholder="(555) 123-4567" required></div>
        </div>
        
        <div class="ntq-row">
          <div class="ntq-field"><label class="ntq-label">Email <span class="req">*</span></label><input type="email" class="ntq-input" placeholder="you@business.com" required></div>
          <div class="ntq-field"><label class="ntq-label">Business Name</label><input type="text" class="ntq-input" placeholder="Your business"></div>
        </div>

        <div class="ntq-row">
          <div class="ntq-field"><label class="ntq-label">Upload Logo</label><div class="ntq-file-wrap"><input type="file" accept="image/*"><div class="ntq-file-label"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>Click to upload</div></div></div>
          <div class="ntq-field"><label class="ntq-label">Sign Usage <span class="req">*</span></label><select class="ntq-input" required><option value="">Select usage</option><option>Indoor</option><option>Outdoor</option><option>Both</option></select></div>
        </div>

        <div class="ntq-row">
          <div class="ntq-field"><label class="ntq-label">Mockup Type <span class="req">*</span></label><select class="ntq-input" required><option value="">Select sign type</option><option>Lightbox Signs (Recommended)</option><option>Halo Lit Letters (Recommended)</option><option>3D Metal Backlit</option><option>Acrylic Front Lit</option><option>Channel Letters</option></select></div>
          <div class="ntq-field"><label class="ntq-label">Estimated Size</label><input type="text" class="ntq-input" placeholder="e.g. 5ft x 2ft"></div>
        </div>

        <div class="ntq-row">
          <div class="ntq-field full"><label class="ntq-label">Project Details</label><textarea class="ntq-textarea" placeholder="Tell us about your project timeline or specific needs..."></textarea></div>
        </div>

        <button type="submit" class="ntq-submit">GET MY FREE MOCKUP <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
      </form>

      <div class="ntq-trust">
        <p><svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-6 4.5L18 22l-6-4-6 4 2-8.5L2 9h7z"/></svg> <strong>4.9/5</strong> from 450+ businesses</p>
        <p><svg viewBox="0 0 24 24"><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/><circle cx="12" cy="12" r="10"/></svg> Installed in <strong>all 50 states</strong></p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NT Quote Final Form",
  "presets": [
    {
      "name": "NT Quote Final Form"
    }
  ]
}
{% endschema %}