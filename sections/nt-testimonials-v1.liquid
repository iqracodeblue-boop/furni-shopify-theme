<!-- sections/nt-testimonials-v1.liquid -->
<style>
  .nt-testi-section { background: #f5f5f5; padding: 88px 24px; font-family: 'Inter', system-ui, sans-serif; }
  .nt-testi-container { max-width: 1180px; margin: 0 auto; }
  
  .nt-testi-head { text-align: center; max-width: 680px; margin: 0 auto 56px; }
  .nt-sec-label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: #0188cc; margin-bottom: 16px; }
  .nt-sec-label::before, .nt-sec-label::after { content: ''; width: 24px; height: 1px; background: #0188cc; }
  .nt-testi-head h2 { font-family: 'DM Serif Display', serif; font-size: 2.2rem; color: #111; line-height: 1.05; margin-bottom: 14px; font-weight: 400; }
  .nt-testi-head h2 em { color: #0188cc; font-style: italic; }
  .nt-testi-head p { font-size: 1rem; color: #666; line-height: 1.65; }

  .nt-testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 880px) { .nt-testi-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .nt-testi-grid { grid-template-columns: 1fr; } }

  .nt-testi-card { background: #fff; border-radius: 14px; border: 1px solid rgba(0,0,0,0.07); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column; }
  .nt-testi-card:hover { transform: translateY(-3px); box-shadow: 0 18px 34px rgba(0,0,0,0.08); }
  
  .nt-testi-media { position: relative; aspect-ratio: 4/3; background: #111; overflow: hidden; cursor: pointer; }
  .nt-testi-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .nt-testi-card:hover .nt-testi-media img { transform: scale(1.04); }
  
  /* Video Play Button Overlay */
  .nt-play-btn { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 54px; height: 54px; background: rgba(255,255,255,0.85); border-radius: 50%; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .nt-play-btn::after { content: ''; border-style: solid; border-width: 8px 0 8px 14px; border-color: transparent transparent transparent #0188cc; margin-left: 4px; }

  .nt-testi-content { padding: 24px 28px; display: flex; flex-direction: column; flex: 1; }
  .nt-testi-stars { display: flex; gap: 2px; margin-bottom: 16px; }
  .nt-testi-stars svg { width: 16px; height: 16px; fill: #f5a623; }
  
  .nt-testi-quote { font-size: 0.96rem; line-height: 1.7; color: #333; margin-bottom: 24px; font-weight: 400; flex: 1; }

  .nt-testi-author { display: flex; align-items: center; gap: 14px; padding-top: 18px; border-top: 1px solid rgba(0,0,0,0.07); }
  .nt-testi-avatar { width: 44px; height: 44px; border-radius: 50%; background: #111; color: #0188cc; font-family: 'DM Serif Display', serif; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(1,136,204,0.24); flex-shrink: 0; }
  .nt-testi-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .nt-testi-name { font-size: 0.88rem; font-weight: 700; color: #111; display: flex; align-items: center; gap: 6px; }
  .nt-testi-name svg { width: 14px; height: 14px; fill: #0188cc; }
  .nt-testi-date { font-size: 0.76rem; color: #666; margin-top: 2px; }

  .nt-testi-prod { margin-top: 16px; padding-top: 16px; border-top: 1px dashed #e0e0e0; font-size: 0.8rem; color: #666; }
  .nt-testi-prod strong { text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; color: #111; display: block; margin-bottom: 4px; }
  .nt-testi-prod a { color: #0188cc; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; font-size: 0.85rem; }
  .nt-testi-prod a:hover { text-decoration: underline; }

  .nt-testi-more { display: flex; justify-content: center; margin-top: 44px; }
  .nt-show-more-btn { background: #111; color: #fff; border: none; padding: 16px 32px; border-radius: 8px; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: background 0.2s; text-transform: uppercase; letter-spacing: 0.05em; }
  .nt-show-more-btn:hover { background: #0188cc; }
  
  .nt-testi-card.hidden { display: none; }
</style>

<section class="nt-testi-section">
  <div class="nt-testi-container">
    <div class="nt-testi-head">
      <span class="nt-sec-label">WHO WE'VE WORKED WITH</span>
      <h2>The Businesses Behind the <em>Signs</em></h2>
      <p>We could tell you why Signs.inc is different. Or you could hear it from the businesses who've already found out.</p>
    </div>

    <div class="nt-testi-grid" id="ntTestiGrid">
      {% comment %} Hardcoded Array of 40 Real Sign Images {% endcomment %}
      {% assign imgs = "https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg, https://i.ibb.co/Z1bRvmFX/1a8bfc475f04e41dc4168ddc673f5e30.jpg, https://i.ibb.co/VcjZ4ZBF/000.png, https://i.ibb.co/jPLvTFk4/Storefronts-2.jpg, https://i.ibb.co/tpq229Zx/86e7f4ccec44b08749e3403e5c444a65.jpg, https://i.ibb.co/zhspw9Zp/e099e6192c61020ed637eaefeee78b12.jpg, https://i.ibb.co/JFC3PgnK/2d-metal-5mm-image-2.jpg, https://i.ibb.co/B2JQnr6N/74d052ff-c4ee-4cb5-ac7e-183dcb40f0e2.png, https://i.ibb.co/Txv6T1Xs/73a77a70eba24d8090295aa71ab1a4c5.jpg, https://i.ibb.co/DH0FFQCd/66793f20edb71e28c00f7e453b711b46.jpg" | split: ", " %}
      
      {% assign names = "Matthew M.,Saskia V.,Jaclyn D.,Tony M.,Sarah L.,Mike G.,Lisa S.,David T.,Amanda M.,Jason R.,Karen N.,Robert J.,Paul T.,Rachel L.,Marcus R.,Jamie K.,Emily B.,Chris P.,Nina S.,Omar F.,Lucy H.,Sam K.,David W.,Alex G.,Sophia A.,Daniel E.,Grace L.,Henry Q.,Ivy M.,Jack R.,Kylie T.,Leo V.,Mia X.,Noah B.,Olivia C.,Peter D.,Quinn E.,Ruby F.,Steven G.,Tara H." | split: "," %}
      
      {% assign texts = "Unbelievable! Fast and extremely professional!,The design service was very helpful!,The sign looks very professional and high quality!,Best marketing money we ever spent.,Filled out the form on a Tuesday. Mockup back before lunch.,The backlit logo changed the whole feel of the office.,Walk-in oil changes went up 40%!,Seamless coordination.,I did not make a single call to the city.,Revenue went up 22% the first month.,Membership inquiries doubled in 60 days.,The neon wall has been in hundreds of Instagram posts.,Consistent quality every time.,Zero surprises.,Installed in under three weeks.,Exactly what we needed.,They handled zoning and permits.,Both signs were installed the same week.,Looks incredible at night.,Mockup matched the final product perfectly.,Highly recommend!,Great communication throughout.,Top notch service from start to finish.,Will use them again for our second location.,The team was amazing from start to finish.,Quality is unmatched!,Better than we imagined.,Fast shipping and great packaging.,The LED lights are so bright.,Perfect for our lobby.,Easy installation process.,Customers love taking photos with it.,Worth every penny.,A true partner in our business.,The mockup sold us immediately.,No hidden fees, fair pricing.,The metal work is beautiful.,Our brand finally looks premium.,Couldn't be happier.,5 stars all the way!" | split: "," %}

      {% for i in (1..40) %}
        {% assign index = forloop.index0 | modulo: 10 %}
        {% assign name_index = forloop.index0 | modulo: 40 %}
        {% assign text_index = forloop.index0 | modulo: 40 %}
        
        <div class="nt-testi-card {% if i > 20 %}hidden{% endif %}">
          <div class="nt-testi-media">
            <img src="{{ imgs[index] }}" alt="Customer Review Image" loading="lazy">
            {% comment %} Add Video Play Button on every 3rd card to simulate videos {% endcomment %}
            {% assign mod = i | modulo: 3 %}
            {% if mod == 0 %}
              <div class="nt-play-btn"></div>
            {% endif %}
          </div>
          <div class="nt-testi-content">
            <div class="nt-testi-stars">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
            </div>
            <p class="nt-testi-quote">{{ texts[text_index] }}</p>
            
            <div class="nt-testi-author">
              <div class="nt-testi-avatar">{{ names[name_index] | slice: 0 }}</div>
              <div class="nt-testi-meta">
                <span class="nt-testi-name">
                  {{ names[name_index] }}
                  <svg viewBox="0 0 24 24"><path d="M9.5 16.5l-4-4 1.4-1.4 2.6 2.6 6.6-6.6 1.4 1.4z" fill="#0188cc"/></svg>
                </span>
                <span class="nt-testi-date">06/{{ i | plus: 10 }}/2026</span>
              </div>
            </div>

            <div class="nt-testi-prod">
              <strong>Custom Mockup Sign for {{ names[name_index] }}</strong>
              <a href="#">View product
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="nt-testi-more">
      <button class="nt-show-more-btn" id="ntShowMoreBtn" onclick="ntShowMoreReviews()">Show more reviews</button>
    </div>
  </div>
</section>

<script>
  function ntShowMoreReviews() {
    var hiddenCards = document.querySelectorAll('.nt-testi-card.hidden');
    hiddenCards.forEach(function(card) {
      card.classList.remove('hidden');
    });
    document.getElementById('ntShowMoreBtn').style.display = 'none'; // Hide button after click
  }
</script>

{% schema %}
{
  "name": "NT Testimonials v1",
  "settings": [],
  "presets": [{"name": "NT Testimonials v1"}]
}
{% endschema %}