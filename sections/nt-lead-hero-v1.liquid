<!-- sections/nt-lead-hero-v1.liquid -->
<style>
  :root {
    --ink: #111111;
    --body: #333333;
    --muted: #666666;
    --bg: #ffffff;
    --line2: rgba(0, 0, 0, 0.12);
    --accent: #0188cc;
    --acch: #016da0;
    --teal-bright: #02a0eb;
    --fh-hero: 'DM Serif Display', Georgia, serif;
    --fb: 'Inter', system-ui, sans-serif;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .nt-hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background-color: #0a0a0a;
    background-image: url('https://i.ibb.co/gFdwCYNb/Chat-GPT-Image-Jun-29-2026-03-11-07-PM.png');
    background-size: cover;
    background-position: center 30%;
    padding: 100px 20px 40px;
  }
  .nt-hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(100deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.78) 38%, rgba(0, 0, 0, 0.35) 58%, rgba(0, 0, 0, 0.1) 100%);
  }
  
  .nt-hero-container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    align-items: start;
    max-width: 1320px;
    margin: 0 auto;
    gap: 48px;
  }
  
  .nt-hero-left { display: flex; flex-direction: column; gap: 20px; }
  .nt-h1 { font-family: var(--fh-hero); font-size: clamp(30px, 3.6vw, 52px); color: #fff; line-height: 1.06; }
  .nt-h1 .accent { color: var(--teal-bright); }
  .nt-hero-lede { font-family: var(--fb); font-size: 16px; color: rgba(255, 255, 255, 0.72); max-width: 520px; }
  
  .nt-hero-right { background: #fff; padding: 18px; border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
  
  /* Form Styles */
  .qf-wrap { width: 100%; }
  .qf-title { font-family: var(--fh-hero); font-size: 22px; color: #111; text-transform: uppercase; margin-bottom: 12px; }
  .qf-section { border: 1.5px solid #e0e0e0; border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
  .qf-section-label { background: #0188cc; color: #fff; padding: 10px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .qf-section-body { padding: 14px; }
  .qf-field { margin-bottom: 8px; display: flex; flex-direction: column; gap: 4px; }
  .qf-label { font-size: 10.5px; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 0.07em; }
  .qf-input { width: 100%; padding: 10px 12px; border: 1.5px solid #ddd; border-radius: 8px; font-size: 14px; box-sizing: border-box; }
  .qf-input:focus { border-color: #0188cc; outline: none; }
  .qf-submit { width: 100%; background: #0188cc; color: #fff; border: none; padding: 13px; border-radius: 10px; font-size: 15px; font-weight: 700; text-transform: uppercase; cursor: pointer; margin-top: 10px; }
  .qf-submit:hover { background: #0170a8; }
  
  /* Gallery */
  .showcase { margin-top: 20px; max-width: 620px; }
  .showcase-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; grid-template-rows: repeat(2, 1fr); gap: 7px; border-radius: 16px; overflow: hidden; }
  .sc-feature { grid-row: span 2; position: relative; overflow: hidden; }
  .sc-feature img, .sc-cell img { width: 100%; height: 100%; object-fit: cover; cursor: pointer; transition: transform 0.5s; }
  .sc-feature img:hover, .sc-cell img:hover { transform: scale(1.05); }
  .sc-cell { position: relative; overflow: hidden; aspect-ratio: 4/3; }
  .sc-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 7px 6px; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent); color: #fff; font-size: 9.5px; font-weight: 700; text-transform: uppercase; }
  
  @media (max-width: 1024px) {
    .nt-hero-container { grid-template-columns: 1fr; }
    .showcase { max-width: 100%; }
  }
</style>

<section class="nt-hero-section">
  <div class="nt-hero-container">
    <!-- Left Side -->
    <div class="nt-hero-left">
      <h1 class="nt-h1">Custom 3D business signs.<br><span class="accent">Free quote &amp; mockup.</span></h1>
      <p class="nt-hero-lede">Looking for custom storefront signs, illuminated business signage, backlit signs, or dimensional logo signs? Upload your logo for a free mockup and quote on premium indoor and outdoor signage, built to last and shipped fast.</p>
      
      <div class="showcase">
        <div class="showcase-grid">
          <div class="sc-feature" style="grid-column:1;grid-row:1/3">
            <img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="3D Metal Backlit" onclick="openLightbox(this.src)">
            <div class="sc-label">3D Metal Backlit</div>
          </div>
          <div class="sc-cell" style="grid-column:2;grid-row:1">
            <img src="https://i.ibb.co/1Gp76c58/cb25442aad4c8435bb11a509ccc4b132.jpg" alt="Halo Lit" onclick="openLightbox(this.src)">
            <div class="sc-label">Halo Lit</div>
          </div>
          <div class="sc-cell" style="grid-column:2;grid-row:2">
            <img src="https://i.ibb.co/B2JQnr6N/74d052ff-c4ee-4cb5-ac7e-183dcb40f0e2.png" alt="Acrylic Front Lit" onclick="openLightbox(this.src)">
            <div class="sc-label">Acrylic Front Lit</div>
          </div>
          <div class="sc-cell" style="grid-column:3;grid-row:1">
            <img src="https://i.ibb.co/Txv6T1Xs/73a77a70eba24d8090295aa71ab1a4c5.jpg" alt="Push Thru Sign" onclick="openLightbox(this.src)">
            <div class="sc-label">Push Thru Sign</div>
          </div>
          <div class="sc-cell" style="grid-column:3;grid-row:2">
            <img src="https://i.ibb.co/DH0FFQCd/66793f20edb71e28c00f7e453b711b46.jpg" alt="Backlit w/ Backboard" onclick="openLightbox(this.src)">
            <div class="sc-label">Backlit w/ Backboard</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Side Form -->
    <div class="nt-hero-right">
      <form class="qf-wrap" action="/contact#ContactForm" method="post">
        <h2 class="qf-title">Tell us about your sign.</h2>
        
        <div class="qf-section">
          <div class="qf-section-label">Contact Information <span style="color:#c0392b">*</span></div>
          <div class="qf-section-body">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
              <div class="qf-field">
                <label class="qf-label">Your name</label>
                <input class="qf-input" type="text" name="name" placeholder="First and last name" required>
              </div>
              <div class="qf-field">
                <label class="qf-label">Phone</label>
                <input class="qf-input" type="tel" name="phone" placeholder="(555) 123-4567">
              </div>
            </div>
            <div class="qf-field">
              <label class="qf-label">Email</label>
              <input class="qf-input" type="email" name="email" placeholder="you@yourbusiness.com" required>
            </div>
            <div class="qf-field">
              <label class="qf-label">Upload your logo</label>
              <input class="qf-input" type="file" name="logo" accept="image/*,.pdf,.ai,.eps">
            </div>
          </div>
        </div>

        <div class="qf-section">
          <div class="qf-section-label">Sign Details</div>
          <div class="qf-section-body">
            <div class="qf-field">
              <label class="qf-label">Project details</label>
              <textarea class="qf-input" name="details" rows="3" placeholder="Wall material, budget, timeline..."></textarea>
            </div>
          </div>
        </div>

        <button type="submit" class="qf-submit">Get My Free Mockup</button>
      </form>
    </div>
  </div>
</section>

<!-- Lightbox JS -->
<div id="nt-lightbox" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); z-index:9999; justify-content:center; align-items:center;" onclick="closeLightbox()">
  <img id="nt-lightbox-img" src="" style="max-width:90%; max-height:90%; border-radius:8px;">
</div>

<script>
  function openLightbox(src) {
    var lb = document.getElementById('nt-lightbox');
    var img = document.getElementById('nt-lightbox-img');
    img.src = src;
    lb.style.display = 'flex';
  }
  function closeLightbox() {
    document.getElementById('nt-lightbox').style.display = 'none';
  }
</script>

