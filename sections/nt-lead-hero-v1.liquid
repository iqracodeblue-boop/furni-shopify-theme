<!-- sections/nt-lead-hero-v1.liquid -->
<style>
  :root {
    --fh-hero: 'DM Serif Display', Georgia, serif;
    --fb: 'Inter', system-ui, sans-serif;
    --accent: #0188cc;
    --acch: #016da0;
    --ink: #111111;
    --muted: #666666;
    --line2: rgba(0, 0, 0, 0.12);
  }

  .nt-hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background-color: #0a0a0a;
    background-image: url('https://i.ibb.co/gFdwCYNb/Chat-GPT-Image-Jun-29-2026-03-11-07-PM.png');
    background-size: cover;
    background-position: center 30%;
    padding-top: 100px;
  }
  .nt-hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(100deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.78) 38%, rgba(0, 0, 0, 0.35) 58%, rgba(0, 0, 0, 0.1) 100%);
  }

  .nt-stage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    align-items: start;
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px 48px 32px;
    gap: 48px;
  }

  /* Left Side */
  .nt-hero-left { display: flex; flex-direction: column; gap: 20px; }
  .nt-kicker { display: inline-flex; align-items: center; gap: 9px; font-family: var(--fb); font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.8); padding: 7px 14px; border-radius: 100px; background: rgba(1, 136, 204, 0.12); border: 1px solid rgba(1, 136, 204, 0.32); width: max-content; }
  .nt-kicker span { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
  .nt-h1 { font-family: var(--fh-hero); font-size: clamp(30px, 3.6vw, 52px); color: #fff; line-height: 1.06; }
  .nt-h1 .accent { color: #02a0eb; }
  .nt-lede { font-family: var(--fb); font-size: 16px; color: rgba(255,255,255,0.72); max-width: 520px; }

  .nt-showcase { margin-top: 10px; max-width: 620px; }
  .nt-showcase-label { font-family: var(--fb); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 10px; display: block; }
  .nt-showcase-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; grid-template-rows: repeat(2, 1fr); gap: 7px; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 56px rgba(0,0,0,0.6); }
  .nt-sc-feature { grid-row: span 2; position: relative; overflow: hidden; }
  .nt-sc-cell { position: relative; overflow: hidden; aspect-ratio: 4/3; }
  .nt-sc-feature img, .nt-sc-cell img { width: 100%; height: 100%; object-fit: cover; cursor: pointer; transition: transform 0.5s; }
  .nt-sc-feature:hover img, .nt-sc-cell:hover img { transform: scale(1.05); }
  .nt-sc-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 7px 6px; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent); color: #fff; font-size: 9.5px; font-weight: 700; text-transform: uppercase; }
  .nt-sc-feature-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 30px 14px 14px; background: linear-gradient(to top, rgba(0,0,0,0.88), transparent); }
  .nt-sc-feature-label strong { font-family: var(--fh-hero); font-size: 0.98rem; color: #fff; display: block; }
  .nt-sc-feature-label span { font-family: var(--fb); font-size: 0.68rem; color: rgba(255,255,255,0.6); }

  .nt-proof { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .nt-proof-item { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(1, 136, 204, 0.22); border-radius: 8px; font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.8); }
  .nt-proof-item svg { width: 14px; height: 14px; stroke: var(--accent); fill: none; stroke-width: 2; }

  /* Right Side Form */
  .nt-hero-right { display: flex; flex-direction: column; gap: 14px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
  .nt-delivery-banner { display: flex; align-items: center; justify-content: space-between; background: #111; padding: 8px 16px; }
  .nt-del-left { display: flex; align-items: center; gap: 8px; }
  .nt-del-text { font-family: var(--fb); font-size: 11.5px; font-weight: 700; color: #fff; }
  .nt-del-text span { color: #5cbef0; }
  .nt-del-right { display: flex; align-items: center; gap: 7px; color: #fff; font-size: 11.5px; font-weight: 700; text-decoration: none; }
  .nt-del-right svg { width: 13px; height: 13px; stroke: var(--accent); fill: none; stroke-width: 2; }

  .qf-wrap { padding: 18px 18px 14px; }
  .qf-title { font-family: var(--fh-hero); font-size: 22px; color: #111; text-transform: uppercase; margin-bottom: 12px; }
  
  .qf-section { border: 1.5px solid #e0e0e0; border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
  .qf-section-label { background: var(--accent); color: #fff; padding: 8px 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; display: flex; align-items: center; gap: 6px; }
  .qf-section-req { color: #c0392b; }
  .qf-section-body { padding: 14px; }

  .qf-field { margin-bottom: 8px; display: flex; flex-direction: column; gap: 4px; }
  .qf-label { font-size: 10.5px; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 0.07em; display: flex; justify-content: space-between; }
  .qf-label .opt { font-weight: 400; color: #999; text-transform: none; font-size: 11px; }
  .qf-input-wrap { position: relative; display: flex; align-items: center; }
  .qf-input-icon { position: absolute; left: 12px; color: #bbb; width: 16px; height: 16px; pointer-events: none; }
  .qf-input { width: 100%; background: #fff; border: 1.5px solid #ddd; border-radius: 8px; padding: 10px 12px 10px 36px; color: #111; font-family: var(--fb); font-size: 14px; box-sizing: border-box; }
  .qf-input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(1,136,204,0.13); }
  .qf-textarea { padding: 10px 12px; resize: none; min-height: 38px; line-height: 1.45; }
  .qf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  /* Upload Box */
  .qf-file-wrap { position: relative; display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 10px 12px; background: #fff; border: 2px dashed #ccc; border-radius: 8px; cursor: pointer; }
  .qf-file-wrap:hover { border-color: var(--accent); background: #f5faff; }
  .qf-file-wrap input[type='file'] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
  .qf-file-icon { color: var(--accent); flex-shrink: 0; width: 22px; height: 22px; }
  .qf-file-text { display: flex; flex-direction: column; gap: 1px; }
  .qf-file-main { font-size: 13px; font-weight: 600; color: #111; }
  .qf-file-main a { color: var(--accent); text-decoration: underline; }
  .qf-file-hint { font-size: 11px; color: #999; }

  /* Toggle Buttons */
  .qf-toggle-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .qf-toggle-btn { display: flex; align-items: center; justify-content: center; gap: 7px; background: #fff; border: 1.5px solid #ddd; border-radius: 8px; padding: 10px; font-family: var(--fb); font-size: 13.5px; font-weight: 500; color: #444; cursor: pointer; transition: 0.15s; }
  .qf-toggle-btn:hover { border-color: var(--accent); color: #111; }
  .qf-toggle-btn.sel { border-color: var(--accent); color: var(--accent); font-weight: 700; box-shadow: 0 0 0 3px rgba(1,136,204,0.12); }

  /* Mockup Grid */
  .qf-mockup-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px; }
  .qf-mockup-card { position: relative; border: 2px solid #e0e0e0; border-radius: 8px; overflow: hidden; cursor: pointer; transition: 0.15s; }
  .qf-mockup-card:hover { border-color: var(--accent); }
  .qf-mockup-card.sel { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(1,136,204,0.2); }
  .qf-mockup-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; pointer-events: none; }
  .qf-mockup-info { padding: 6px 7px 5px; background: #fff; display: flex; flex-direction: column; gap: 3px; }
  .qf-mockup-name { font-size: 11.5px; font-weight: 600; color: #111; }
  .qf-mockup-badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; background: #e8f4f0; color: #0d7a5f; width: max-content; }
  .qf-mockup-card.sel .qf-mockup-badge { background: var(--accent); color: #fff; }

  /* Submit */
  .qf-submit { width: 100%; background: var(--accent); color: #fff; border: none; padding: 13px; border-radius: 10px; font-size: 15px; font-weight: 700; text-transform: uppercase; cursor: pointer; margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 18px rgba(1,136,204,0.32); }
  .qf-submit:hover { background: var(--acch); }
  
  .qf-trust-row { margin-top: 8px; padding-top: 8px; border-top: 1px solid #eee; display: flex; justify-content: space-between; gap: 8px; }
  .qf-trust-item { display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; color: #888; text-transform: uppercase; }
  .qf-trust-item svg { width: 12px; height: 12px; stroke: var(--accent); stroke-width: 2; fill: none; }

  @media (max-width: 1024px) {
    .nt-stage { grid-template-columns: 1fr; padding: 16px 20px 48px; }
    .nt-hero-section { min-height: auto; padding-top: 80px; }
  }
</style>

<section class="nt-hero-section">
  <div class="nt-stage">
    <!-- Left Side -->
    <div class="nt-hero-left">
      <div class="nt-kicker"><span></span> Free Mock up and Quote in two hours</div>
      <h1 class="nt-h1">Custom 3D business signs.<br><span class="accent">Free quote &amp; mockup.</span></h1>
      <p class="nt-lede">Looking for custom storefront signs, illuminated business signage, backlit signs, or dimensional logo signs? Upload your logo for a free mockup and quote on premium indoor and outdoor signage, built to last and shipped fast.</p>
      
      <div class="nt-showcase">
        <span class="nt-showcase-label">What we build</span>
        <div class="nt-showcase-grid">
          <div class="nt-sc-feature" style="grid-column:1;grid-row:1/3">
            <img src="https://i.ibb.co/Kcw6nP6Y/2ed997c391e78c87e4ef3323b6ce9594.jpg" alt="3D Metal Backlit" onclick="openLightbox(this.src)">
            <div class="nt-sc-feature-label"><strong>3D Metal Backlit</strong><span>Our most-ordered storefront sign</span></div>
          </div>
          <div class="nt-sc-cell" style="grid-column:2;grid-row:1">
            <img src="https://i.ibb.co/1Gp76c58/cb25442aad4c8435bb11a509ccc4b132.jpg" alt="Halo Lit" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">Halo Lit</div>
          </div>
          <div class="nt-sc-cell" style="grid-column:2;grid-row:2">
            <img src="https://i.ibb.co/B2JQnr6N/74d052ff-c4ee-4cb5-ac7e-183dcb40f0e2.png" alt="Acrylic Front Lit" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">Acrylic Front Lit</div>
          </div>
          <div class="nt-sc-cell" style="grid-column:3;grid-row:1">
            <img src="https://i.ibb.co/Txv6T1Xs/73a77a70eba24d8090295aa71ab1a4c5.jpg" alt="Push Thru Sign" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">Push Thru Sign</div>
          </div>
          <div class="nt-sc-cell" style="grid-column:3;grid-row:2">
            <img src="https://i.ibb.co/DH0FFQCd/66793f20edb71e28c00f7e453b711b46.jpg" alt="Backlit w/ Backboard" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">Backlit w/ Backboard</div>
          </div>
          <div class="nt-sc-cell" style="grid-column:4;grid-row:1">
            <img src="https://i.ibb.co/07TMQzZ/2d-blade-sign-image-8.png" alt="3D Blade Sign" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">3D Blade Sign</div>
          </div>
          <div class="nt-sc-cell" style="grid-column:4;grid-row:2">
            <img src="https://i.ibb.co/2mRQ7Y0/e0cc8c5e140f122c969efb850e696e44.jpg" alt="UV Acrylic" onclick="openLightbox(this.src)">
            <div class="nt-sc-label">UV Acrylic</div>
          </div>
        </div>
      </div>

      <div class="nt-proof">
        <div class="nt-proof-item">
          <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free shipping, all 50 states
        </div>
        <div class="nt-proof-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Mockup in 2 hours
        </div>
        <div class="nt-proof-item">
          <svg viewBox="0 0 24 24"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
          Factory direct pricing
        </div>
      </div>
    </div>

    <!-- Right Side Form -->
    <div class="nt-hero-right">
      <div class="nt-delivery-banner">
        <div class="nt-del-left">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0188CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div class="nt-del-text"><span>FREE SHIPPING</span> to all 50 States</div>
        </div>
        <a href="tel:12059007525" class="nt-del-right">
          <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          +1 205 900 7525
        </a>
      </div>

      <form class="qf-wrap js-lead-form" action="javascript:void(0)">
        <h2 class="qf-title">Tell us about your sign.</h2>
        
        <!-- Hidden UUID Field for JS -->
        <input type="hidden" name="uuid" class="form-uuid">

        <!-- Section 1 -->
        <div class="qf-section">
          <div class="qf-section-label">Contact Information <span class="qf-section-req">*</span></div>
          <div class="qf-section-body">
            <div class="qf-row">
              <div class="qf-field">
                <label class="qf-label">Your name</label>
                <div class="qf-input-wrap">
                  <svg class="qf-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <input class="qf-input form-input" type="text" name="name" required>
                </div>
                <span class="error-text" data-error="name" style="color: red; font-size: 12px; display: block; margin-top: 4px;"></span>
              </div>
              <div class="qf-field">
                <label class="qf-label">Phone</label>
                <div class="qf-input-wrap">
                  <svg class="qf-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
                  <input class="qf-input form-input" type="tel" name="phone" required>
                </div>
                <span class="error-text" data-error="phone" style="color: red; font-size: 12px; display: block; margin-top: 4px;"></span>
              </div>
            </div>
            <div class="qf-field">
              <label class="qf-label">Email</label>
              <div class="qf-input-wrap">
                <svg class="qf-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m2 7 10 7 10-7"/></svg>
                <input class="qf-input form-input" type="email" name="email" required>
              </div>
              <span class="error-text" data-error="email" style="color: red; font-size: 12px; display: block; margin-top: 4px;"></span>
            </div>
            <div class="qf-field">
              <label class="qf-label">Upload your logo <span class="opt">Recommended</span></label>
              <label class="qf-file-wrap">
                <svg class="qf-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span class="qf-file-text">
                  <span class="qf-file-main">Logo &amp; site photo — drop or <a href="#" onclick="return false">browse</a></span>
                  <span class="qf-file-hint">PNG, JPG, PDF, AI, EPS, SVG — Max 20 MB each</span>
                </span>
                <input type="file" name="image" class="form-image" accept="image/*,.pdf,.ai,.eps" required>
              </label>
              <span class="error-text" data-error="image" style="color: red; font-size: 12px; display: block; margin-top: 4px;"></span>
            </div>
          </div>
        </div>

        <!-- Section 2 -->
        <div class="qf-section">
          <div class="qf-section-label">Sign Details</div>
          <div class="qf-section-body">
            <div class="qf-field">
              <label class="qf-label">Sign usage</label>
              <div class="qf-toggle-row">
                <button type="button" class="qf-toggle-btn" onclick="toggleBtn(this)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Indoor
                </button>
                <button type="button" class="qf-toggle-btn" onclick="toggleBtn(this)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v4m6.36.64l-2.83 2.83M20 12h4M17.66 17.66l2.83 2.83M12 20v4M4.34 17.66l-2.83 2.83M4 12H0M6.34 6.34L3.51 3.51"/><circle cx="12" cy="12" r="5"/></svg> Outdoor
                </button>
              </div>
            </div>

            <div class="qf-field">
              <label class="qf-label">Select mockup type(s)</label>
              <div class="qf-mockup-grid">
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/b6d42cc645663d276ce14ed30556dca0_3fc4a075-1ffa-4c1f-8bf0-1250d36f862a.jpg?v=1784115140" alt="Lightbox">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Lightbox</div><span class="qf-mockup-badge">Recommended</span></div>
                </div>
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/image_52.webp?v=1784021842" alt="Halo Lit">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Halo Lit</div><span class="qf-mockup-badge">Recommended</span></div>
                </div>
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/a41f50aee39a3c269c600156808215e7_33604a3c-bf4c-429a-ab64-609105320a86.jpg?v=1784115146" alt="Face Lit">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Face Lit</div><span class="qf-mockup-badge">Recommended</span></div>
                </div>
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/2d85a2a2fc7666b85ef8c76c8d30591a.jpg?v=1774339718" alt="Flat Cut">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Flat Cut</div></div>
                </div>
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/1164690c75c91f2fa591ac6e1af532d9.jpg?v=1773827490" alt="Fabricated">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Fabricated</div></div>
                </div>
                <div class="qf-mockup-card" onclick="toggleMockup(this)">
                  <img src="https://cdn.shopify.com/s/files/1/0598/2096/6023/files/Push-Through-Sign.jpg?v=1773828070" alt="Push Through">
                  <div class="qf-mockup-info"><div class="qf-mockup-name">Push Through</div></div>
                </div>
              </div>
            </div>

            <div class="qf-field">
