<!-- sections/nt-faq-v1.liquid -->
<style>
  .nt-faq-section { background: #fff; padding: 88px 48px; }
  .nt-faq-inner { max-width: 780px; margin: 0 auto; }
  .nt-faq-head { text-align: center; margin-bottom: 56px; }
  .nt-faq-head h2 { font-family: 'DM Serif Display', serif; font-size: 2.2rem; color: #111; margin-bottom: 14px; font-weight: 400; }
  .nt-faq-head h2 em { color: #0188cc; font-style: italic; }
  .nt-faq-item { border-bottom: 1px solid rgba(0,0,0,0.1); padding: 6px 0; }
  .nt-faq-q { width: 100%; text-align: left; padding: 22px 0; font-family: 'DM Serif Display', serif; font-size: 1.18rem; color: #111; display: flex; justify-content: space-between; align-items: center; background: none; border: none; cursor: pointer; }
  .nt-faq-q:hover { color: #0188cc; }
  .nt-faq-a { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .nt-faq-a-inner { padding: 0 0 22px; font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #333; line-height: 1.7; }
  .nt-faq-item.open .nt-faq-a { max-height: 400px; }
  .nt-faq-icon { width: 28px; height: 28px; border: 1px solid rgba(0,0,0,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: 0.3s; }
  .nt-faq-item.open .nt-faq-icon { background: #0188cc; border-color: #0188cc; color: #fff; transform: rotate(45deg); }
  @media (max-width: 768px) { .nt-faq-section { padding: 64px 24px; } }
</style>

<section class="nt-faq-section">
  <div class="nt-faq-head">
    <h2>Frequently <em>Asked</em></h2>
  </div>
  <div class="nt-faq-inner">
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="toggleFaq(this)">
        How long does it take to get a custom sign made?
        <span class="nt-faq-icon">+</span>
      </button>
      <div class="nt-faq-a"><div class="nt-faq-a-inner">Most custom signs are designed, manufactured and shipped within 10 to 14 business days. You will receive a free digital mockup within 2 hours of submitting your details.</div></div>
    </div>
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="toggleFaq(this)">
        Do you install signs across all 50 states?
        <span class="nt-faq-icon">+</span>
      </button>
      <div class="nt-faq-a"><div class="nt-faq-a-inner">Yes. Signs.inc has a vetted network of licensed, insured professional installers in all 50 states.</div></div>
    </div>
    <div class="nt-faq-item">
      <button class="nt-faq-q" onclick="toggleFaq(this)">
        What kind of warranty do you offer?
        <span class="nt-faq-icon">+</span>
      </button>
      <div class="nt-faq-a"><div class="nt-faq-a-inner">Every sign we manufacture is covered by a 2-years warranty on electrical components, LED modules and structural integrity.</div></div>
    </div>
  </div>
</section>

<script>
  function toggleFaq(btn) {
    var item = btn.parentElement;
    item.classList.toggle('open');
  }
</script>

{% schema %}
{
  "name": "NT FAQ v1",
  "settings": [],
  "presets": [{"name": "NT FAQ v1"}]
}
{% endschema %}